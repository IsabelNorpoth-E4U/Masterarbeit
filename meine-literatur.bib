@Inbook{cb05,
author="Kurpicz-Briki, Mascha",
title="Haben Chatbots Gef{\"u}hle?",
bookTitle="Mehr als ein Chatbot: Die Entmystifizierung der Sprachmodelle",
year="2024",
publisher="Springer Nature Switzerland",
address="Cham",
