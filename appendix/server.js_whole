// Update Company
app.put('/api/admin/companies/:id', verifyFirebaseToken, verifyAdmin, async (req, res) => {
  try {
    const { id } = req.params;
    const { name, code, max_users, daily_msg_limit, valid_from, valid_until, allowed_models, allowed_domains } = req.body;
    
    // Logging für Debug
    console.log(`[ADMIN] UpdateCompany ${id}:`, {
      name, code, max_users, daily_msg_limit, valid_from, valid_until, allowed_models, allowed_domains,
      user: req.user?.email
    });

    const companyRef = db.collection("companies").doc(id);
    const companyDoc = await companyRef.get();
    
    if (!companyDoc.exists) {
      return res.status(404).json({ error: "Company not found" });
    }

    const updateData = {};
    if (name) updateData.name = name;
    if (code) updateData.code = code; // Check uniqueness if changed? Assuming admin knows what they do.
    if (max_users !== undefined) updateData.max_users = parseInt(max_users);
    if (daily_msg_limit !== undefined) updateData.daily_msg_limit = parseInt(daily_msg_limit);
    if (valid_from) updateData.valid_from = new Date(valid_from);
    if (valid_until) updateData.valid_until = new Date(valid_until);
    if (allowed_models) updateData.allowed_models = allowed_models;
    
    if (allowed_domains !== undefined) {
      updateData.allowed_domains = Array.isArray(allowed_domains) 
        ? allowed_domains 
        : (typeof allowed_domains === 'string' ? allowed_domains.split(',').map(d => d.trim().toLowerCase()).filter(Boolean) : []);
    }

    updateData.updated_at = admin.firestore.FieldValue.serverTimestamp();
    updateData.updated_by = req.user.email;

    await companyRef.update(updateData);
    res.json({ success: true, ...updateData });
  } catch (err) {
    console.error("Error updating company:", err);
    res.status(500).json({ error: "Failed to update company" });
  }
});

// Delete Company
app.delete('/api/admin/companies/:id', verifyFirebaseToken, verifyAdmin, async (req, res) => {
  try {
    const { id } = req.params;
    console.log(`[ADMIN] DeleteCompany ${id} requested by ${req.user.email}`);

    const companyRef = db.collection("companies").doc(id);
    const companyDoc = await companyRef.get();
    
    if (!companyDoc.exists) {
      return res.status(404).json({ error: "Company not found" });
    }

    // Check if users exist for this company?
    // Optionally remove company_id from users?
    // For now, just delete the company. Users will be orphaned (will fall into "no company" state in verifyFirebaseUser, allowing them to re-register)
    
    // We should probably unlink users to be clean.
    const usersSnap = await db.collection("users").where("company_id", "==", id).get();
    
    const batch = db.batch();
    batch.delete(companyRef);
    
    usersSnap.docs.forEach(doc => {
        batch.update(doc.ref, { 
            company_id: admin.firestore.FieldValue.delete(),
            demo_active: false
        });
    });
    
    await batch.commit();

    res.json({ success: true });
  } catch (err) {
    console.error("Error deleting company:", err);
    res.status(500).json({ error: "Failed to delete company" });
  }
});

// Get Company Users & Usage
app.get('/api/admin/companies/:id/users', verifyFirebaseToken, verifyAdmin, async (req, res) => {
  try {
    const { id } = req.params;
    
    // 1. Get all users for this company
    const usersSnap = await db.collection("users").where("company_id", "==", id).get();
    
    const today = new Date().toISOString().split('T')[0];
    
    const users = await Promise.all(usersSnap.docs.map(async (doc) => {
       const userData = doc.data();
       const uid = doc.id;
       
       // 2. Get usage for today
       const usageDoc = await db.collection("users").doc(uid).collection("usage_logs").doc(today).get();
       const usageToday = usageDoc.exists ? usageDoc.data().count : 0;
       
       // 3. Calculate detailed stats from sessions/messages
       let total_input = 0;
       let total_output = 0;
       let total_cost = 0;
       let session_count = 0;
       let model_counts = {};
       let mode_counts = {};
       
       const sessionsSnap = await db.collection("users").doc(uid).collection("chat_sessions").get();
       session_count = sessionsSnap.size;

       // Fetch messages for all sessions in parallel
       const sessionPromises = sessionsSnap.docs.map(async sessionDoc => {
           const msgsSnap = await sessionDoc.ref.collection("messages").get();
           msgsSnap.forEach(msgDoc => {
               const msg = msgDoc.data();
               const input = msg.tokens_input || 0;
               const output = msg.tokens_output || 0;
               total_input += input;
               total_output += output;
               
               const model = msg.model || 'unknown';
               
               if (msg.cost_total !== undefined) {
                   total_cost += msg.cost_total;
               } else {
                   // Use calculateCost helper
                   let modelKey = model;
                   if (!MODEL_PRICING[modelKey]) {
                       modelKey = model.toLowerCase();
                       if (!MODEL_PRICING[modelKey]) {
                           if (modelKey.includes('gpt-4o')) modelKey = 'gpt-4o';
                           else if (modelKey.includes('gpt-4')) modelKey = 'gpt-4';
                           else if (modelKey.includes('gpt-3.5')) modelKey = 'gpt-3.5-turbo';
                           else if (modelKey.includes('gemini')) modelKey = 'gemini-1.5-pro';
                           else if (modelKey.includes('claude')) modelKey = 'claude-3-sonnet';
                           else modelKey = 'default';
                       }
                   }
                   total_cost += calculateCost(modelKey, input, output);
               }

               // Count stats only for User messages (Requests) to match user expectation
               if (msg.role === 'user') {
                   model_counts[model] = (model_counts[model] || 0) + 1;
                   const mode = msg.mode || 'normal';
                   mode_counts[mode] = (mode_counts[mode] || 0) + 1;
               }
           });
       });
       
       await Promise.all(sessionPromises);
       
       const total_messages = Object.values(model_counts).reduce((a, b) => a + b, 0);

       let limit_request_count = 0;
       try {
           const limitSnap = await db.collection("users").doc(uid).collection("limit_requests").get();
           limit_request_count = limitSnap.size;
       } catch (e) {
           console.error('Error fetching limit requests:', e);
       }

       return {
         uid,
         email: userData.email,
         registered_at: userData.registered_at ? (userData.registered_at.toDate ? userData.registered_at.toDate() : userData.registered_at) : null,
         usage_today: usageToday,
         last_active: userData.updated_at ? (userData.updated_at.toDate ? userData.updated_at.toDate() : userData.updated_at) : null,
         stats: {
             total_input_tokens: total_input,
             total_output_tokens: total_output,
             total_cost: total_cost,
             session_count: session_count,
             model_count: Object.keys(model_counts).length,
             model_breakdown: model_counts,
             mode_breakdown: mode_counts,
             total_messages: total_messages,
             limit_request_count: limit_request_count
         }
       };
    }));

    res.json(users);
  } catch (err) {
    console.error("Error fetching company users:", err);
    res.status(500).json({ error: "Failed to fetch company users" });
  }
});

// --- Demo Registration Endpoint ---

app.post('/api/register-demo', verifyFirebaseToken, async (req, res) => {
  const { code } = req.body;
  const { uid, email } = req.user;

  console.log(`[REGISTER-DEMO] Called by ${email} with code ${code}`);

  if (!code) return res.status(400).json({ error: "Code is required" });

  try {
    // Find company by code
    const companiesSnap = await db.collection("companies").where("code", "==", code).limit(1).get();
    
    if (companiesSnap.empty) {
      console.warn(`[REGISTER-DEMO] Code ${code} not found in DB.`);
      return res.status(400).json({ error: "Ungültiger Code." });
    }

    const companyDoc = companiesSnap.docs[0];
    const companyData = companyDoc.data();
    const companyId = companyDoc.id;

    // Logging für Debug
    console.log('[REGISTER-DEMO] Attempt:', {
      user: email,
      code,
      companyId,
      current_users: companyData.current_users,
      max_users: companyData.max_users,
      allowed_domains: companyData.allowed_domains,
      user_domain: email.split('@')[1],
      projectId: admin.app().options.projectId,
      dbName: FIRESTORE_DB_NAME
    });

    // Validation
    const now = new Date();
    if (companyData.valid_until && now > companyData.valid_until.toDate()) {
      return res.status(400).json({ error: "Dieser Code ist abgelaufen." });
    }

    // Check allowed_domains
    if (companyData.allowed_domains && companyData.allowed_domains.length > 0) {
      const userDomain = email.split('@')[1].toLowerCase();
      const allowed = companyData.allowed_domains.map(d => d.toLowerCase().trim());
      if (!allowed.includes(userDomain)) {
        return res.status(400).json({ error: `Ihre E-Mail-Domain (${userDomain}) ist für diesen Code nicht freigeschaltet.` });
      }
    }

    // Check max users
    if (companyData.current_users >= companyData.max_users) {
      return res.status(400).json({ error: "Es gibt keine freien Plätze mehr für die Demo-Version ihrer Firma" });
    }

    // Check if user is already registered (idempotency)
    const userRef = db.collection("users").doc(uid);
    const userSnap = await userRef.get();
    if (userSnap.exists && userSnap.data().company_id) {
       // Already registered?
       if (userSnap.data().company_id === companyId) {
         return res.json({ success: true, message: "Bereits registriert." });
       }
       return res.status(400).json({ error: "Nutzer ist bereits einem anderen Code zugewiesen." });
    }

    // Run transaction to link user and increment counter
    await db.runTransaction(async (t) => {
      const coDoc = await t.get(companyDoc.ref);
      const current = coDoc.data().current_users || 0;
      
      if (current >= companyData.max_users) {
        throw new Error("Es gibt keine freien Plätze mehr für die Demo-Version ihrer Firma");
      }

      const userDocTr = await t.get(userRef);
      const isNewUser = !userDocTr.exists;

      const updateData = {
        company_id: companyId,
        demo_active: true,
        registered_at: admin.firestore.FieldValue.serverTimestamp(),
        email: email,
        updated_at: admin.firestore.FieldValue.serverTimestamp()
      };

      if (isNewUser) {
        updateData.created_at = admin.firestore.FieldValue.serverTimestamp();
      }

      t.update(companyDoc.ref, { current_users: current + 1 });
      t.set(userRef, updateData, { merge: true });
    });

    res.json({ success: true });

  } catch (err) {
    console.error("Error registering demo user:", err);
    res.status(500).json({ error: err.message || "Registrierung fehlgeschlagen." });
  }
});

