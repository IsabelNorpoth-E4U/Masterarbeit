app.get('/api/model-config', async (req, res) => {
  try {
    let modelConfig;
    const modelConfigB64 = process.env.MODEL_CONFIG_B64;
    const modelConfigStr = process.env.MODEL_CONFIG;
    
    if (modelConfigB64) {
      // Decode base64-encoded config (from GitHub Actions)
      const decoded = Buffer.from(modelConfigB64, 'base64').toString('utf-8');
      modelConfig = JSON.parse(decoded);
    } else if (modelConfigStr) {
      // Direct JSON (for local development)
      modelConfig = JSON.parse(modelConfigStr);
    } else {
      modelConfig = {};
    }
    
    // Filter if external version and user has company
    if (IS_EXTERNAL_VERSION && req.userData && req.userData.company_id) {
       try {
         const companyDoc = await db.collection("companies").doc(req.userData.company_id).get();
         if (companyDoc.exists) {
            const companyData = companyDoc.data();
            if (companyData.allowed_models && companyData.allowed_models.length > 0) {
               const allowed = companyData.allowed_models;
               const filteredConfig = {};
               for (const [key, config] of Object.entries(modelConfig)) {
                  // Check against key or name
                  if (allowed.includes(key) || allowed.includes(config.name)) {
                     filteredConfig[key] = config;
                  }
               }
               modelConfig = filteredConfig;
            }
         }
       } catch (err) {
         console.error('Error filtering models:', err);
       }
    }
    
    // Sanitize config - remove potentially sensitive fields like api_key, endpoint
    const safeConfig = {};
    for (const [key, config] of Object.entries(modelConfig)) {
      safeConfig[key] = {
        name: config.name,
        provider: config.provider,
        deployment: config.deployment,
        description: config.description
      };
    }
    
    res.json(safeConfig);
  } catch (err) {
    console.error('Error parsing MODEL_CONFIG:', err);
    res.status(500).json({ error: 'Failed to load model configuration' });
  }
});

// Public/Protected file access
app.get('/api/files/*', async (req, res, next) => {
  // Bearer Token Auth via Middleware (req.user is set)
  // Cookies are explicitly disabled for security
  if (!req.user) {
     return res.status(404).send('Not Found');
  }
  return handleFileRequest(req, res);
});

// Helper for file serving
async function handleFileRequest(req, res) {
  const filePath = req.params[0]; // Captures everything after /api/files/
  
  if (!filePath) {
    return res.status(400).send('Invalid path');
  }

  // Security Check: Directory Traversal
  if (filePath.includes('..')) {
      return res.status(400).send('Invalid path');
  }

  // External Version Check
  const isExternal = process.env.VITE_IS_EXTERNAL_VERSION === 'true';
  if (isExternal && !filePath.startsWith('public/')) {
      // Return 404 to hide existence of internal files
      return res.status(404).send('Not Found');
  }

  const bucketName = process.env.GCS_BUCKET_INTERNAL || 'e4u-internal-knowledge-bucket';
  const bucket = admin.storage().bucket(bucketName);
  const file = bucket.file(filePath);

  try {
      const [exists] = await file.exists();
      if (!exists) {
          return res.status(404).send('Not Found');
      }

      const [metadata] = await file.getMetadata();
      const contentType = metadata.contentType || 'application/pdf';

      res.setHeader('Content-Type', contentType);
      res.setHeader('Content-Disposition', `inline; filename="${path.basename(filePath)}"`);

      file.createReadStream()
          .on('error', (err) => {
              console.error('Stream Error:', err);
              if (!res.headersSent) {
                res.status(500).end();
              }
          })
          .pipe(res);

  } catch (error) {
      console.error('GCS Error:', error);
      if (!res.headersSent) {
        res.status(404).send('Not Found');
      }
  }
}

// Protected endpoints (auth required) - Redundant middleware removed
let ENCRYPTION_KEY = null; // Wird später geladen

async function loadEncryptionKey() {
  if (process.env.USE_LOCAL_ENCRYPTION_KEY === 'true') {
    console.warn("⚠️ Using LOCAL dummy encryption key. Do not use in production!");
    ENCRYPTION_KEY = Buffer.alloc(32, 'a'); // 32 bytes of 'a'
    return;
  }

  try {
    const client = new SecretManagerServiceClient();
    const projectId = process.env.GOOGLE_CLOUD_PROJECT || process.env.GCLOUD_PROJECT || 'ai-tools-436214';
    console.log(`Loading encryption key from project: ${projectId}`);
    const [version] = await client.accessSecretVersion({
      name: `projects/${projectId}/secrets/DB_ENCRYPTION_KEY_GLOBAL/versions/latest`
    });
    ENCRYPTION_KEY = Buffer.from(version.payload.data.toString('utf8'), 'base64');
    if (ENCRYPTION_KEY.length !== 32) {
      throw new Error("ENCRYPTION_KEY must be 32 bytes (256 bit) for AES-256-GCM");
    }
  } catch (err) {
    console.warn("⚠️ Failed to load encryption key from Secret Manager:", err.message);
    if (process.env.IS_EXTERNAL_VERSION === 'true' || process.env.NODE_ENV === 'development') {
      console.warn("⚠️ Falling back to dummy encryption key for DEV/DEMO mode.");
      ENCRYPTION_KEY = Buffer.alloc(32, 'a');
    } else {
      throw err;
    }
  }
}
const IV_LENGTH = 12; // GCM empfiehlt 12 bytes



function encrypt(data) {
  const input = Buffer.isBuffer(data)
    ? data
    : typeof data === "string"
      ? data
      : JSON.stringify(data);
 
  const iv = crypto.randomBytes(IV_LENGTH);
  const cipher = crypto.createCipheriv(
    "aes-256-gcm",
    Buffer.from(ENCRYPTION_KEY),
    iv
  );
 
  let encrypted;
  if (Buffer.isBuffer(input)) {
    encrypted = Buffer.concat([cipher.update(input), cipher.final()]).toString("base64");
  } else {
    encrypted = cipher.update(input, "utf8", "base64") + cipher.final("base64");
  }
 
  const tag = cipher.getAuthTag();
  return `${iv.toString("base64")}:${tag.toString("base64")}:${encrypted}`;
}

function decrypt(data) {
  const [ivB64, tagB64, encrypted] = data.split(':');
  const iv = Buffer.from(ivB64, 'base64');
  const tag = Buffer.from(tagB64, 'base64');
  const decipher = crypto.createDecipheriv('aes-256-gcm', Buffer.from(ENCRYPTION_KEY), iv);
  decipher.setAuthTag(tag);
  let decrypted = decipher.update(encrypted, 'base64', 'utf8');
  decrypted += decipher.final('utf8');
  return decrypted;
}

/**
 * Count tokens in a text string using tiktoken
 */
function countTokens(text) {
  try {
    const safeText =
      typeof text === "string"
        ? text
        : JSON.stringify(text ?? "");
 
    const enc = encoding_for_model("gpt-4");
    const tokens = enc.encode(safeText);
    const count = tokens.length;
    enc.free();
    return count;
  } catch (err) {
    console.error("Error counting tokens:", err);
    return 0;
  }
}

/**
 * Extract attachments with token counts from additionalContent
 */
function extractAttachmentsWithTokens(additionalContent) {
  const attachments = [];
  if (!additionalContent || !additionalContent.trim()) {
    return attachments;
  }
  
  try {
    // Split by file markers
    const filePattern = /File: ([^;]+); Size: ([^;]+); Content:\s*([\s\S]*?)(?=File: |$)/g;
    let match;
    
    while ((match = filePattern.exec(additionalContent)) !== null) {
      const filename = match[1].trim();
      const size = match[2].trim();
      const content = match[3].trim();
      
      const tokens = countTokens(content);
      
      attachments.push({
        filename: encrypt(filename),
        size: size,
        tokens: tokens
      });
    }
  } catch (err) {
    console.error('Error extracting attachments with tokens:', err);
  }
  
  return attachments;
}

/**
 * Calculate token breakdown from attachments and messages
 */
function calculateTokenBreakdown(attachments, currentMessage, additionalContent, systemPrompt, messageHistory, historyLimit = 20) {
  const attachment_tokens = attachments.reduce((sum, att) => sum + (att.tokens || 0), 0);
  const user_request_tokens = countTokens(currentMessage);
  const system_prompt_tokens = systemPrompt ? countTokens(systemPrompt) : 0;

  // Calculate conversation history tokens
  let conversation_history_tokens = 0;
  if (messageHistory && messageHistory.length > 0) {
    const relevantHistory = historyLimit != null ? messageHistory.slice(-historyLimit) : messageHistory;
    for (const msg of relevantHistory) {
      conversation_history_tokens += countTokens(msg.text || '');
    }
  }
  
  return {
    system_prompt_tokens: system_prompt_tokens,
    context_tokens: 0,  // Will be set by backend for RAG queries (energy-bot mode)
    conversation_history_tokens: conversation_history_tokens,
    user_request_tokens: user_request_tokens,
    attachment_tokens: attachment_tokens
  };
}

async function generateTitleWithOpenAI(userMessage, assistantResponse) {

  const prompt = `Lies dir die folgende Unterhaltung zwischen einem Nutzer und einem KI-Assistenten durch. Gib basierend auf dem Inhalt einen kurzen, prägnanten Titel zurück – in derselben Sprache wie die Unterhaltung. Antworte nur mit dem Titel, ohne weitere Erklärungen.

  User: ${userMessage}
  Assistant: ${assistantResponse}
  
  Titel:`;
  const url = `${endpoint}/openai/deployments/${deployment}/chat/completions?api-version=${version}`;

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'api-key': apiKey
      },
      body: JSON.stringify({
        messages: [
          { role: "system", content: prompt }
        ],
        max_tokens: 100, // Limit the response to a short title
        temperature: 0.5, // Adjust temperature for creativity
        top_p: 0.95,
        frequency_penalty: 0,
        presence_penalty: 0,
      })
    });

    const data = await response.json();

    if (!data || !data.choices || !data.choices[0]?.message?.content) {
      console.warn("⚠️ OpenAI returned unexpected format:", data);
      throw new Error("Invalid response from OpenAI");
    }

    return data.choices[0].message.content.trim();
  } catch (err) {
    console.error("❌ OpenAI title generation error:", err);
    throw err;
  }
}

