async function startServer() {
  try {
    await loadEncryptionKey();
    console.log("Encryption key loaded ✅");

    // Danach Express starten
    server.listen(PORT, () => {
      console.log(`✅ Server listening on http://localhost:${PORT}`);
    });
  } catch (err) {
    console.error("Fehler beim Laden des ENCRYPTION_KEY:", err);
    process.exit(1); // Bricht bei Fehler sauber ab
  }
}

startServer();