/**
 * Log activity event to Firestore for analytics
 * @param {Object} eventData - Event data to log
 */
async function logActivityEvent(eventData) {
  try {
    const {
      uid,
      session_id,
      event_type,
      model,
      usage,
      timings,
      result,
      attachments
    } = eventData;

    // Validate required fields
    if (!uid || !event_type) {
      console.warn('⚠️ Activity event missing required fields (uid, event_type)');
      return;
    }

    // Build the event document
    const eventDoc = {
      uid,
      session_id: session_id || null,
      event_type, // 'chat_turn' or 'rag_turn'
      ts_server: admin.firestore.FieldValue.serverTimestamp(),
      
      model: {
        id: model?.id || 'unknown',
        provider: model?.provider || 'unknown',
        name: model?.name || 'unknown'
      },
      
      usage: {
        prompt_tokens: usage?.prompt_tokens || 0,
        completion_tokens: usage?.completion_tokens || 0,
        total_tokens: usage?.total_tokens || 0
      },
      
      cost: {
        total: eventData.cost?.total || 0,
        llm: eventData.cost?.llm || 0,
        embedding: eventData.cost?.embedding || 0,
        vision: eventData.cost?.vision || 0,
        energie: eventData.cost?.energie || 0,
        rag: eventData.cost?.rag || 0,
        hyde: eventData.cost?.hyde || 0,
      },
      
      timings: {
        total_ms: timings?.total_ms || 0,
        ttft_ms: timings?.ttft_ms || null,
        chunks_count: timings?.chunks_count || 0
      },
      
      result: {
        status: result?.status || 'ok',
        http_status: result?.http_status || 200,
        error_message: result?.error_message || null
      },
      
      attachments: {
        count: attachments?.count || 0,
        total_bytes: attachments?.total_bytes || 0
      }
    };

    // Log to Firestore activity_events collection
    await db.collection('activity_events').add(eventDoc);
    
  } catch (err) {
    // Don't fail the main request if logging fails
    console.error('❌ Failed to log activity event:', err.message);
  }
}

// NodeCanvasFactory class
class NodeCanvasFactory {
  create(width, height) {
    const canvas = createCanvas(width, height);
    const context = canvas.getContext('2d');
    return { canvas, context };
  }

  reset(canvasAndContext, width, height) {
    canvasAndContext.canvas.width = width;
    canvasAndContext.canvas.height = height;
  }

  destroy(canvasAndContext) {
    canvasAndContext.canvas = null;
    canvasAndContext.context = null;
  }
}


async function callBackend(method, path, data = undefined) {
  const auth = new GoogleAuth();
  const client = await auth.getIdTokenClient(BACKEND_URL);
  const config = {
    url: `${BACKEND_URL}${path}`,
    method,
  };
  if (data && method !== 'GET') {
    config.data = data;
  }
  return await client.request(config);
}

async function verifyFirebaseToken(req, res, next) {
  const authHeader = req.headers.authorization;

  if (!authHeader || !authHeader.startsWith("Bearer ")) {
    return res.status(401).json({ error: "Kein gültiger Token übermittelt" });
  }

  const idToken = authHeader.split(" ")[1];

  try {
    const decodedToken = await admin.auth().verifyIdToken(idToken);
    req.user = decodedToken; // Nutzer-Info für später
    next();
  } catch (error) {
    console.error("Token ungültig:", error.message);
    return res.status(401).json({ error: "Tokenprüfung fehlgeschlagen" });
  }
}
// Utility to forward headers safely
const getAuthHeader = (req) => {
  const token = req.headers.authorization?.split(' ')[1];
  return token ? `Bearer ${token}` : null;
};

app.post('/api/upload-pptx', upload.single('file'), async (req, res) => {
  try {
    const filePath = req.file.path;
    const textParts = [];

    fs.createReadStream(filePath)
      .pipe(unzipper.Parse())
      .on('entry', async function (entry) {
        const fileName = entry.path;
        if (fileName.startsWith("ppt/slides/slide") && fileName.endsWith(".xml")) {
          const xml = await entry.buffer();
          parseString(xml, (err, result) => {
            if (err) return;
            const paragraphs = result['p:sld']['p:cSld'][0]['p:spTree'][0]['p:sp'] || [];
            for (const p of paragraphs) {
              try {
                const runs = p['p:txBody'][0]['a:p'];
                for (const r of runs) {
                  const texts = r['a:r']?.map(rt => rt['a:t']?.[0]).filter(Boolean) || [];
                  textParts.push(...texts);
                }
              } catch (e) { /* ignore errors per slide */ }
            }
          });
        } else {
          entry.autodrain();
        }
      })
      .on('close', () => {
        fs.unlinkSync(filePath); // cleanup
        res.json({ text: textParts.join(' ') });
      });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Fehler beim Verarbeiten der PPTX-Datei." });
  }
});

app.post('/api/upload-image', upload.single('file'), async (req, res) => {
  try {
    const filePath = req.file.path;

    const formData = new FormData();
    formData.append('image', fs.createReadStream(filePath));

    const auth = new GoogleAuth();
    const client = await auth.getIdTokenClient(BACKEND_URL);
    const headers = formData.getHeaders();
    const googleHeaders = await client.getRequestHeaders();
    Object.assign(headers, googleHeaders);
    const response = await axios.post(`${BACKEND_URL}/api/process-image`, formData, {
      headers,
    });
    fs.unlinkSync(filePath); // cleanup

    res.status(response.status).json(response.data);
  } catch (err) {
    console.error('Error processing image:', err?.response?.data || err);
    res.status(500).json({ error: 'Fehler beim Verarbeiten des Bildes.' });
  }
});
// Proxy: Parse PDF
app.post('/api/parse-pdf', verifyFirebaseToken, upload.single('pdf'), async (req, res) => {
  const uploadId = req.headers['x-upload-id'] || '';

  try {
    const form = new FormData();
    form.append('pdf', fs.createReadStream(req.file.path));

    const auth = new GoogleAuth();
    const client = await auth.getIdTokenClient(BACKEND_URL);

    const headers = form.getHeaders({ 'x-upload-id': uploadId });

    // 👉 Workaround für axios + google-auth-client: Stream manuell senden
    const response = await axios({
      method: 'post',
      url: `${BACKEND_URL}/api/parse-pdf`,
      headers: {
        ...headers,
        ...(await client.getRequestHeaders())
      },
      data: form
    });

    res.status(response.status).json(response.data);
  } catch (err) {
    console.error('❌ Proxy error: /parse-pdf', err.message);
    res.status(500).json({ error: 'Failed to forward to backend' });
  } finally {
    fs.unlink(req.file.path, () => { });
  }
});

