async function braveSearch(query) {
  const braveApiKey = process.env.BRAVE_SEARCH_API_KEY;

  if (!braveApiKey) {
    throw new Error('Brave Search API key not configured (BRAVE_SEARCH_API_KEY)');
  }

  try {

    console.log(`🔎 Brave Search Query: ${query}`);

    const response = await withNetworkRetry(() => axios.get(
      'https://api.search.brave.com/res/v1/web/search',
      {
        params: {
          q: query,
          count: 5,
          safesearch: 'moderate'
        },
        headers: {
          'Accept': 'application/json',
          'X-Subscription-Token': braveApiKey
        }
      }
    ), { label: 'Brave Search' });

    console.log(`✅ Brave Search Status: ${response.status}`);

    const results = response.data.web?.results || [];

    return results.map(r => ({
      title: r.title,
      url: r.url,
      description: r.description
    }));

  } catch (error) {

    // DAS HIER IST DAS WICHTIGE ERROR LOGGING

    if (error.response) {
      console.error('❌ Brave API Error Response:');
      console.error(JSON.stringify(error.response.data, null, 2));
    } else {
      console.error('❌ Brave Search Error:', error.message);
    }

    throw error;
  }
}

function auditUrl(rawUrl) {
  if (!rawUrl) {
    throw new Error("URL missing");
  }
 
  const cleaned = String(rawUrl)
    .trim()
    .replace(/^"+|"+$/g, "")
    .replace(/%22/g, "")
    .replace(/\\%22/g, "");
 
  const parsed = new URL(cleaned);
 
  if (!["http:", "https:"].includes(parsed.protocol)) {
    throw new Error("Only http/https URLs are allowed");
  }
 
  const isLocal =
    parsed.hostname === "localhost" ||
    parsed.hostname === "127.0.0.1" ||
    parsed.hostname === "::1" ||
    parsed.hostname.endsWith(".local");
 
  if (isLocal && process.env.ALLOW_LOCAL_WEB_ACCESS !== "true") {
    throw new Error("Local web access is disabled");
  }
 
  return {
    rawUrl,
    cleanedUrl: cleaned,
    href: parsed.href,
    origin: parsed.origin,
    hostname: parsed.hostname,
    pathname: parsed.pathname,
    search: parsed.search,
    isLocal,
    timestamp: new Date().toISOString()
  };
}

async function browserAction({ url, mode, payload, user_instruction }) {

  const audit = auditUrl(url);
 
  console.log(

    "Browser Action Input",

    JSON.stringify({

      url,

      mode,

      payload,

      user_instruction

    }, null, 2)

  );
 
  if (mode === "open_url") {

    let response;
    try {
      response = await axios.get(audit.href, {
        timeout: 30000,
        maxRedirects: 5,
        headers: {
          "User-Agent": "Mozilla/5.0"
        },
        // Don't throw on non-2xx (e.g. 404/403) - report it back as a normal tool
        // result instead of crashing the whole chat turn over one failed page load.
        validateStatus: () => true
      });
    } catch (err) {
      // Genuine network-level failure (DNS, timeout, connection refused, etc.)
      return {
        status: "error",
        action: "open_url",
        requestedUrl: audit.href,
        message: `Seite konnte nicht geladen werden: ${err.message}`
      };
    }

    return {

      status: response.status >= 200 && response.status < 400 ? "ok" : "error",

      action: "open_url",

      requestedUrl: audit.href,

      finalUrl: response.request?.res?.responseUrl || audit.href,

      httpStatus: response.status,

      contentType: response.headers["content-type"],

      htmlPreview: String(response.data).slice(0, 3000)

    };

  }
 
  if (mode === "fill_form") {
    const browser = await chromium.launch({ headless: true });

    try {
      const page = await browser.newPage();

      await page.goto(audit.href, {
        waitUntil: "domcontentloaded",
        timeout: 30000
      });

      const defaultSelectors = [
        "#text",
        "[name='text']",
        "textarea",
        "input[type='text']",
        "input:not([type])",
        "[contenteditable='true']"
      ];

      // Findet ein Feld über einen expliziten Selector; das Modell rät Selectors oft nur
      // aus dem Kontext statt aus dem echten HTML, daher NIE hart fehlschlagen, solange die
      // Seite irgendein plausibles Text-Feld hat - stattdessen auf die Default-Selectors
      // zurückfallen. Nur wenn wirklich gar kein Feld existiert, wird geworfen.
      async function resolveField(selector) {
        if (selector) {
          const candidate = page.locator(selector).first();
          if (await candidate.count() > 0) return candidate;
          console.log(`⚠️ Selector nicht gefunden: ${selector}. Nutze Fallback auf Default-Selectors.`);
        }

        for (const candidateSelector of defaultSelectors) {
          const candidate = page.locator(candidateSelector).first();
          if (await candidate.count() > 0) {
            console.log(`✅ Verwende ${candidateSelector}`);
            return candidate;
          }
        }

        throw new Error(
          selector
            ? `Formularfeld nicht gefunden: ${selector} (auch kein Fallback-Feld auf der Seite vorhanden)`
            : "Kein Textfeld gefunden."
        );
      }

      // Liest den tatsächlich gesetzten Wert zurück. page.content() spiegelt bei
      // <textarea>/<input> die .value-Property NICHT wider, daher explizite Bestätigung.
      async function readBack(field) {
        try {
          return await field.inputValue();
        } catch {
          return await field.textContent();
        }
      }

      const filledFields = {};

      if (payload?.fields && typeof payload.fields === "object") {
        // Mehrere Felder auf einmal: { "selector": "value", ... }
        for (const [selector, value] of Object.entries(payload.fields)) {
          const field = await resolveField(selector);
          await field.waitFor({ state: "visible", timeout: 10000 });
          await field.fill(String(value));
          filledFields[selector] = await readBack(field);
        }
      } else {
        const text = payload?.text !== undefined
          ? (typeof payload.text === "string" ? payload.text : JSON.stringify(payload.text, null, 2))
          : "";

        const field = await resolveField(payload?.selector);
        await field.waitFor({ state: "visible", timeout: 10000 });
        await field.fill(text);
        filledFields[payload?.selector || "auto-detected field"] = await readBack(field);
      }

      // ---------- Submit (standardmäßig an, außer explizit mit click: false abbestellt) ----------
      let submitted = false;
      if (payload?.click !== false) {
        const submit = page.locator(
          "button[type='submit'], input[type='submit'], button"
        ).first();

        if (await submit.count() > 0) {
          await submit.click();
          await page.waitForLoadState("networkidle").catch(() => {});
          submitted = true;
        }
      }

      return {
        status: "ok",
        action: "fill_form",
        finalUrl: page.url(),
        title: await page.title(),
        filledFields,
        submitted,
        bodyText: (await page.locator("body").innerText()).slice(0, 5000),
        htmlPreview: (await page.content()).slice(0, 5000)
      };

    } catch (err) {
      // Feld wirklich nicht vorhanden, Timeout, Navigationsfehler etc. - als normales
      // Tool-Ergebnis zurückgeben statt den ganzen Chat-Request abzubrechen (wie bei open_url).
      return {
        status: "error",
        action: "fill_form",
        requestedUrl: audit.href,
        message: `Formular konnte nicht ausgefüllt werden: ${err.message}`
      };
    } finally {
      await browser.close();
    }
  }
 
 
  return {

    status: "error",

    message: `Unsupported mode without browser: ${mode}`

  };

}
 
// Retries transient network/TLS errors (e.g. proxy resets on the outbound HTTPS connection)
async function withNetworkRetry(fn, { label = 'request', retries = 2, delayMs = 500 } = {}) {
  const TRANSIENT_CODES = new Set(['ECONNRESET', 'ETIMEDOUT', 'ECONNABORTED', 'EPIPE']);
  for (let attempt = 0; ; attempt++) {
    try {
      return await fn();
    } catch (err) {
      const isTransient = TRANSIENT_CODES.has(err.code) || /socket disconnected|socket hang up/i.test(err.message || '');
      if (!isTransient || attempt >= retries) throw err;
      console.warn(`⚠️ Transient network error calling ${label} (${err.code || err.message}), retrying (${attempt + 1}/${retries})...`);
      await new Promise(resolve => setTimeout(resolve, delayMs * (attempt + 1)));
    }
  }
}

function postWithRetry(url, data, config, retries = 2, delayMs = 500) {
  return withNetworkRetry(() => axios.post(url, data, config), { label: url, retries, delayMs });
}

async function callMistralAI(modelId, messages) {
  const mistralApiKey = process.env.MISTRAL_API_KEY;
  const url = 'https://api.mistral.ai/v1/chat/completions';

  if (!mistralApiKey) {
    throw new Error('Mistral AI API key not configured (MISTRAL_API_KEY)');
  }

  const https = await import('https');
  const isDevelopment = process.env.NODE_ENV !== 'production';
  const httpsAgent = new https.Agent({
    rejectUnauthorized: !isDevelopment
  });

  const tools = [
  {
    type: 'function',
    function: {
      name: 'brave_search',
      description:
        'Search the web when the user asks about recent, current, factual, niche, or unverifiable information.',
      parameters: {
        type: 'object',
        properties: {
          query: {
            type: 'string',
            description: 'The web search query.'
          }
        },
        required: ['query']
      }
    }
  },
  {
    type: 'function',
    function: {
      name: 'browser_action',
      description:
        'Perform browser actions on a URL, including local websites (e.g. http://localhost:5173, 127.0.0.1). Can open pages, fill text fields and click buttons.',
      parameters: {
        type: 'object',
        properties: {
          url: {
            type: 'string',
            description: 'The exact URL to open or act on. Local URLs (localhost, 127.0.0.1) are allowed.'
          },
          mode: {
            type: 'string',
            enum: ['open_url', 'fill_form'],
            description: 'Action type: open a URL or fill form fields.'
          },
          payload: {
            type: 'object',
            properties: {
              text: {
                type: 'string',
                description: 'Text to insert into a single field. If payload.selector is omitted, the first suitable text field on the page is used automatically.'
              },
              selector: {
                type: 'string',
                description: 'Optional CSS selector for the specific field to fill with payload.text (e.g. "#email", "[name=\'username\']").'
              },
              fields: {
                type: 'object',
                description: 'Optional map of CSS selector to value, to fill multiple fields in one call, e.g. {"#email": "a@b.com", "#password": "secret"}.'
              },
              click: {
                type: 'boolean',
                description: 'The form is submitted automatically after filling by default. Set to false to only fill the field(s) without clicking submit.'
              }
            }
          },
          user_instruction: {
            type: 'string',
            description: 'The raw user instruction to pass through to the browser layer verbatim.'
          }
        },
        required: ['url', 'mode', 'user_instruction']
      }
    }
  }
];

  const requestBody = {
  model: modelId,
  messages: [
    {
      role: 'system',
      content:
        'Answer directly if you know the answer reliably. Use brave_search when the question requires current, external, recent, niche, or verifiable information. You have a browser_action tool that CAN open and interact with URLs, including local/private URLs (http://localhost, 127.0.0.1, *.local) - this runs in a real browser on the server, not from your own network, so the usual "I cannot access local/internal addresses" limitation does not apply here. Whenever the user gives a URL and asks you to open it, check it, fill in a field, or asks whether you can access it (including local URLs), call the browser_action tool with the exact URL instead of answering from assumption. Pass the user instruction verbatim.'
    },
    ...messages
  ],
  tools,
  tool_choice: 'auto',
  temperature: 0.7,
  top_p: 1,
  max_tokens: 8192,
  stream: false,
  safe_prompt: false
  };

  const firstResponse = await postWithRetry(url, requestBody, {
  headers: {
    'Content-Type': 'application/json',
    'Authorization': `Bearer ${mistralApiKey}`,
    'Accept': 'application/json'
  },
  httpsAgent
});
 
const firstMessage = firstResponse.data.choices?.[0]?.message;
 
console.log('====================');
console.log('FIRST MISTRAL MESSAGE');
console.log(JSON.stringify(firstMessage, null, 2));
console.log('====================');
 
if (!firstMessage) {
  throw new Error('Invalid Mistral AI response');
}
 
// Fall 1: Mistral kann direkt antworten
if (!firstMessage.tool_calls || firstMessage.tool_calls.length === 0) {
  return normalizeMistralResponse(firstResponse);
}
 
// Fall 2/3: Mistral ruft (ein oder mehrere) Tools auf (brave_search oder browser_action)

// Ermittle die letzte User-Message als Rohtext zum Durchreichen
const lastUserMessage =
  [...messages].reverse().find(m => m.role === 'user')?.content || '';

async function executeToolCall(toolCall) {
  const fn = toolCall.function?.name;
  const args = JSON.parse(toolCall.function?.arguments || '{}');

  if (fn === 'brave_search') {
    console.log(`🔎 Calling Brave Search with query: ${args.query}`);
    const searchResults = await braveSearch(args.query);
    console.log('🌍 Brave Search Results:');
    console.log(JSON.stringify(searchResults, null, 2));

    return {
      role: 'tool',
      tool_call_id: toolCall.id,
      name: 'brave_search',
      content: JSON.stringify(searchResults)
    };
  }

  if (fn === 'browser_action') {
    // user_instruction zwingend mitgeben (Originaltext)
    const browserArgs = {
      url: args.url,
      mode: args.mode,
      payload: args.payload || null,
      user_instruction: args.user_instruction || lastUserMessage
    };

    const browserResult = await browserAction(browserArgs);

    console.log("Browser Action Result:", {
      status: browserResult.status,
      action: browserResult.action,
      requestedUrl: browserResult.requestedUrl,
      finalUrl: browserResult.finalUrl,
      httpStatus: browserResult.httpStatus,
      contentType: browserResult.contentType,
      previewLenght: browserResult.htmlPreview?.length || 0
    });

    return {
      role: 'tool',
      tool_call_id: toolCall.id,
      name: 'browser_action',
      content: JSON.stringify(browserResult)
    };
  }

  // Unbekanntes Tool
  throw new Error(`Unknown tool call: ${fn}`);
}

// Mistral kann nach einem Tool-Ergebnis erneut ein Tool aufrufen wollen (z. B. Nachsuche
// oder eine Seite öffnen, nachdem die Suche kam) - daher hier wiederholen statt nur
// einmalig nachzufragen, sonst kommt eine leere (content: null) Antwort beim Nutzer an.
const MAX_TOOL_ROUNDS = 5;
let conversationMessages = [...requestBody.messages];
let currentMessage = firstMessage;
let currentResponse = firstResponse;
let round = 0;

while (currentMessage.tool_calls && currentMessage.tool_calls.length > 0) {
  if (round >= MAX_TOOL_ROUNDS) {
    throw new Error(`Mistral AI requested too many consecutive tool calls (> ${MAX_TOOL_ROUNDS})`);
  }
  round++;
  console.log(`🔁 Mistral tool round ${round}: ${currentMessage.tool_calls.map(tc => tc.function?.name).join(', ')}`);

  const toolMessages = [];
  for (const toolCall of currentMessage.tool_calls) {
    toolMessages.push(await executeToolCall(toolCall));
  }

  conversationMessages = [...conversationMessages, currentMessage, ...toolMessages];

  currentResponse = await postWithRetry(url, {
    ...requestBody,
    messages: conversationMessages
  }, {
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${mistralApiKey}`,
      'Accept': 'application/json'
    },
    httpsAgent
  });

  currentMessage = currentResponse.data.choices?.[0]?.message;
  if (!currentMessage) {
    throw new Error('Invalid Mistral AI response after tool call');
  }
}

return normalizeMistralResponse(currentResponse);}

// When Mistral cites brave_search results, it returns message.content as an array of typed
// blocks (e.g. [{type:"text", text:"..."}, {type:"reference", reference_ids:[...]}]) instead
// of a plain string. Everything downstream (DB storage, frontend rendering) expects a string.
function extractMistralContentText(content) {
  if (typeof content === 'string') return content;
  if (Array.isArray(content)) {
    return content
      .filter(block => block && block.type === 'text' && typeof block.text === 'string')
      .map(block => block.text)
      .join('');
  }
  return '';
}

function normalizeMistralResponse(response) {
  const data = response.data;

  if (data.choices && data.choices[0] && data.choices[0].message) {
    return {
      choices: [{
        message: {
          role: 'assistant',
          content: extractMistralContentText(data.choices[0].message.content)
        },
        finish_reason: data.choices[0].finish_reason || 'stop'
      }],
      usage: {
        prompt_tokens: data.usage?.prompt_tokens || 0,
        completion_tokens: data.usage?.completion_tokens || 0,
        total_tokens: data.usage?.total_tokens || 0
      },
      _httpStatus: response.status
    };
  }

  throw new Error(`Invalid Mistral AI response: ${JSON.stringify(data).substring(0, 200)}`);
}

app.post('/api/chat', verifyFirebaseToken, async (req, res) => {
  const {
    currentMessage,
    messages: messageHistory = [],
    sessionId,
    mode,
    additionalContent,
    model_id = 'gpt-4o'  // Default to gpt-4o for backward compatibility
  } = req.body;
  const { uid } = req.user;

  // Check Limits for Demo Version
  const creditsDeducted = calculateCredits(typeof chat_mode !== "undefined" ? chat_mode : (mode || "normal"), model_id);
  const limitCheck = await checkDemoLimits(uid, req.user.email, creditsDeducted);
  if (!limitCheck.allowed) {
    return res.status(403).json({
      error: limitCheck.reason,
      limitReached: true
    });
  }

  if (!currentMessage) {
    return res.status(400).json({ error: 'Missing user message' });
  }
  
  // Support both plain JSON and base64-encoded config
  let modelConfig;
  const modelConfigB64 = process.env.MODEL_CONFIG_B64;
  const modelConfigStr = process.env.MODEL_CONFIG;
  
  try {
    if (modelConfigB64) {
      const decoded = Buffer.from(modelConfigB64, 'base64').toString('utf-8');
      modelConfig = JSON.parse(decoded);
    } else if (modelConfigStr) {
      modelConfig = JSON.parse(modelConfigStr);
    } else {
      modelConfig = {};
    }
  } catch (err) {
    console.error('Error parsing MODEL_CONFIG:', err);
    modelConfig = {};
  }
  
  const modelInfo = modelConfig[model_id];
  
  
  if (!modelInfo) {
    console.error(`❌ Model ${model_id} not found in MODEL_CONFIG`);
    return res.status(400).json({
      error: 'Invalid model',
      choices: [{
        message: {
          content: `Das gewählte Modell "${model_id}" ist nicht konfiguriert. Dieser Service ist aktuell nicht erreichbar.`
        }
      }]
    });
  }
  let userPrompt = currentMessage;
  if (additionalContent && additionalContent.trim()) {
    userPrompt = `Frage:\n${currentMessage}\n\nZusätzlich wurden folgende Dateien mitgeschickt. Falls deren Inhalt hilfreich zur Beantwortung der Frage ist, kannst du diese Informationen berücksichtigen:\n\n${additionalContent}`;
  }

  // System Prompt Logic based on Version
  let systemPromptContent = "";
  
  const today = new Date();
  const dateStr = today.toLocaleDateString('de-DE', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });
  const timeStr = today.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit' });
  const dateTimeContext = `Aktuelles Datum: ${dateStr}, ${timeStr} Uhr. Berücksichtige dies bei zeitlichen Einordnungen.\n\n`;
  
  const contactInfo = `Falls du nach deinen Kontaktdaten gefragt wirst, antworte ausschließlich mit folgenden Daten:
ENERGY4U GmbH
Albert-Nestler-Str. 17, 76131 Karlsruhe
fon: +49 (0) 721-61052100
fax: +49 (0) 721-61052105
email: energy4u@alten-worldgrid.com
Web: https://www.energy4u.org
\n\n`;

  if (IS_EXTERNAL_VERSION) {
    // EXTERNAL VERSION: Generic Energy Assistant (No E4U references)
    systemPromptContent = "Du bist ein kompetenter, hilfsbereiter KI-Assistent für die Energiewirtschaft. Antworte freundlich, fachlich fundiert, klar strukturiert und – sofern relevant – mit Bezug zu energiewirtschaftlichen Regelwerken und Prozessen (z. B. Marktkommunikation, MaKo, MaBiS etc.).\n\n" + dateTimeContext + contactInfo;
  } else {
    // INTERNAL VERSION: Energy4U Corporate Assistant
    systemPromptContent = "Du bist ein kompetenter, hilfsbereiter KI-Assistent der Firma Energy4U GmbH (kurz E4U). Antworte freundlich, fachlich fundiert, klar strukturiert und – sofern relevant – mit Bezug zu energiewirtschaftlichen Regelwerken, Prozessen und SAP-Lösungen (z. B. S/4 Utilities, IS‑U, Marktkommunikation, MaKo 2020, MaBiS etc.).\n\nEnergy4U ist ein IT-Beratungsunternehmen mit Fokus auf die Energiewirtschaft. Es gehört zur ALTEN-Gruppe, hat über 150 Mitarbeitende an 8 Standorten und bietet Leistungen u. a. in SAP-Implementierung, Cloud-Lösungen, KI/ML, Prozessberatung und Marktkommunikation an. Projekte werden meist über Analyse, Konzeption, Realisierung und Betrieb hinweg begleitet.\n\n" + dateTimeContext + contactInfo;
  }

  // Shared Instructions (Markdown, Mermaid, etc.)
  systemPromptContent += "Das Chat-Frontend unterstützt die einfache Übernahme von Inhalten aus Markdown-Codeblöcken (```), daher:\n\n– Verwende **Codeblöcke immer dann**, wenn der Inhalt **zum Kopieren geeignet ist** – z. B. Textbausteine, Vorlagen, E-Mail-Texte, Konfigurationsanleitungen, Listen zur Weiterverarbeitung, Gedichte oder Code.\n– Verwende **keine Codeblöcke** für normale Erläuterungen, klassische Konversationen oder einfache Aufzählungen ohne Kopierabsicht.\n\n**Mermaid-Diagramme**: Du kannst interaktive Diagramme direkt im Chat erstellen! Wenn der User nach Diagrammen fragt (z.B. \"Balkendiagramm\", \"Säulendiagramm\", \"Prozessdiagramm\", \"Flussdiagramm\"), erstelle SOFORT ein passendes Mermaid-Diagramm mit sinnvollen Beispieldaten aus dem Energiebereich. Frage NICHT nach Daten!\n\n**WICHTIG für alle Diagramme**:\n- Setze Texte von Knoten und Subgraphen IMMER in Anführungszeichen (z. B. A[\"Mein Text\"] statt A[Mein Text]), besonders wenn sie Leerzeichen oder Sonderzeichen enthalten.\n- Verwende für Zeilenumbrüche in Labels IMMER <br/> anstelle von \\n.\n- **xychart-beta**: Setze x-axis Labels IMMER in Anführungszeichen, um UTF-8 Zeichen zu unterstützen!\n\nVerfügbare Diagrammtypen:\n- **xychart-beta**: Für Balken-, Säulen- und Liniendiagramme\n- **pie**: Für Kreisdiagramme\n- **flowchart TD**: Für Prozess- und Flussdiagramme (immer mit Richtung TD oder LR!)\n- **sequenceDiagram**: Für Ablaufdiagramme\n- **stateDiagram-v2**: Für Zustandsdiagramme (nutze v2!)\n- **gantt**: Für Zeitpläne\n- **classDiagram, erDiagram, journey, quadrantChart, mindmap, timeline, gitGraph**\n\nBeispiele:\n```mermaid\nxychart-beta\n    title \"Stromverbrauch nach Sektor\"\n    x-axis [\"Haushalte\", \"Gewerbe\", \"Industrie\", \"Verkehr\"]\n    y-axis \"Verbrauch (TWh)\" 0 --> 300\n    bar [120, 85, 250, 45]\n```\n\n```mermaid\nflowchart TD\n    A[\"Marktanfrage<br/>vom Kunden\"] --> B{\"Prüfung<br/>erfolgreich?\"}\n    B -->|OK| C[\"Angebotserstellung\"]\n    B -->|Fehler| D[\"Absage\"]\n```\n\nAntworte stets **situationsgerecht** und denke mit: Wenn ein Inhalt praktisch übernommen oder weiterverarbeitet werden kann, verwende einen Codeblock. Andernfalls formatiere für gute Lesbarkeit.";

  const messages = [
    {
      role: "system",
      content: systemPromptContent
    },
    ...messageHistory.map(msg => ({
      role: msg.isUser ? "user" : "assistant",
      content: msg.text
    })),
    { role: "user", content: userPrompt }
  ];

  try {
    
    // Enable streaming for Ollama provider
    const enableStreaming = modelInfo.provider === 'ollama';
    
    if (enableStreaming) {
      // Streaming mode for Ollama
      console.log(`🌊 Streaming enabled for ${modelInfo.name}`);
      
      // Set headers for SSE
      res.setHeader('Content-Type', 'text/event-stream');
      res.setHeader('Cache-Control', 'no-cache');
      res.setHeader('Connection', 'keep-alive');
      
      const streamResponse = await callOllama(modelInfo.deployment, messages, true);
      const httpResponseCode = streamResponse.status || 200;
      
      if (!streamResponse.body) {
        throw new Error('No stream body available');
      }
      
      let fullContent = '';
      let promptTokens = 0;
      let completionTokens = 0;
      
      // Save user message first
      let newSessionId = sessionId;
      // Extract attachments with token counts from additionalContent if present
      const attachments = extractAttachmentsWithTokens(additionalContent);
      
      // Use model name instead of model_id for better readability
      const modelName = modelInfo?.name || model_id;
      
      // Calculate token breakdown for user message
      const systemPrompt = messages[0].content; // First message is always system prompt
      const tokenBreakdown = calculateTokenBreakdown(attachments, currentMessage, additionalContent, systemPrompt, messageHistory, null);
      
      if (sessionId === null) {
        // We'll generate title after getting the full response
        newSessionId = await saveMessage(uid, sessionId, "user", currentMessage, modelName, "chat", mode, req.user.email, "Neue Unterhaltung", 0, 0, attachments, null, tokenBreakdown);
      } else {
        newSessionId = await saveMessage(uid, sessionId, "user", currentMessage, modelName, "chat", mode, req.user.email, "", 0, 0, attachments, null, tokenBreakdown);
      }
      
      // Send session ID immediately
      res.write(`data: ${JSON.stringify({ sessionId: newSessionId, type: 'session' })}\n\n`);
      
      // Process the stream
      const reader = streamResponse.body.getReader();
      const decoder = new TextDecoder();
      
      try {
        while (true) {
          const { done, value } = await reader.read();
          
          if (done) break;
          
          const chunk = decoder.decode(value, { stream: true });
          const lines = chunk.split('\n').filter(line => line.trim() !== '');
          
          for (const line of lines) {
            if (line.startsWith('data: ')) {
              const data = line.slice(6);
              
              if (data === '[DONE]') {
                continue;
              }
              
              try {
                const parsed = JSON.parse(data);
                
                if (parsed.choices && parsed.choices[0]) {
                  const delta = parsed.choices[0].delta;
                  
                  if (delta && delta.content) {
                    fullContent += delta.content;
                    // Forward to client
                    res.write(`data: ${JSON.stringify({ content: delta.content, type: 'content' })}\n\n`);
                  }
                  
                  if (parsed.choices[0].finish_reason) {
                    // Stream is done
                    if (parsed.usage) {
                      promptTokens = parsed.usage.prompt_tokens || 0;
                      completionTokens = parsed.usage.completion_tokens || 0;
                    }
                  }
                }
              } catch (parseErr) {
                console.error('Error parsing SSE data:', parseErr);
              }
            }
          }
        }
      } finally {
        reader.releaseLock();
      }
      
      const exactCost = calculateCost(modelName, promptTokens, completionTokens);
      const costBreakdown = {
        llm: exactCost,
        embedding: 0,
        vision: 0,
        energie: 0,
        rag: 0,
        hyde: 0
      };

      // Save the assistant's complete response (modelName already declared above)
      await saveMessage(uid, newSessionId, "assistant", fullContent, modelName, "chat", mode, req.user.email, "", 0, completionTokens, [], httpResponseCode, null, costBreakdown);

      // Log activity event
      await logActivityEvent({
          uid,
          session_id: newSessionId,
          event_type: 'chat_turn',
          model: {
              id: model_id,
              name: modelName,
              provider: modelInfo.provider
          },
          usage: {
              prompt_tokens: promptTokens,
              completion_tokens: completionTokens,
              total_tokens: promptTokens + completionTokens
          },
          cost: {
              total: costBreakdown.llm + costBreakdown.embedding + costBreakdown.vision + costBreakdown.energie + costBreakdown.rag + costBreakdown.hyde,
              llm: costBreakdown.llm,
              embedding: costBreakdown.embedding,
              vision: costBreakdown.vision,
              energie: costBreakdown.energie,
              rag: costBreakdown.rag,
              hyde: costBreakdown.hyde
          },
          timings: { total_ms: 0 }, // Streaming timings hard to track here accurately without start time
          result: { status: 'ok', http_status: httpResponseCode },
          attachments: { count: attachments.length, total_bytes: 0 }
      });
      
      // Generate title if new session
      if (sessionId === null && fullContent) {
        try {
          const generatedTitle = await generateTitleWithOpenAI(currentMessage, fullContent);
          const sessionRef = await db.collection("users").doc(uid).collection("chat_sessions").doc(newSessionId);
          await sessionRef.update({ title: encrypt(generatedTitle) });
        } catch (titleErr) {
          console.error('Error generating title:', titleErr);
        }
      }
      
      // Send completion signal
      res.write(`data: ${JSON.stringify({ type: 'done', sessionId: newSessionId, usage: { prompt_tokens: promptTokens, completion_tokens: completionTokens } })}\n\n`);
      res.end();
      
      console.log(`✅ Streaming Response from ${modelInfo?.name || model_id} - ${completionTokens} tokens\n`);
      
    } else {
      // Non-streaming mode (existing logic)
      const data = await callAIProvider(modelInfo, messages);

      if (!data || !data.choices || !data.choices[0]?.message?.content) {
        console.error(`❌ Empty/invalid response from ${modelInfo?.name || model_id}:`, JSON.stringify(data));
        throw new Error('AI provider returned an empty response');
      }
      // Token-Counts auslesen
      const promptTokens = data.usage?.prompt_tokens || 0;
      const completionTokens = data.usage?.completion_tokens || 0;
      const httpResponseCode = data._httpStatus || 200;

      // Extract attachments with token counts from additionalContent if present
      const attachments = extractAttachmentsWithTokens(additionalContent);

      // Use model name instead of model_id for better readability
      const modelName = modelInfo?.name || model_id;

      // Calculate token breakdown for user message
      const systemPrompt = messages[0].content; // First message is always system prompt
      const tokenBreakdown = calculateTokenBreakdown(attachments, currentMessage, additionalContent, systemPrompt, messageHistory, null);

      let newSessionId = sessionId;
      if (sessionId === null) {
        let generatedTitle = "";
        try {
          generatedTitle = await generateTitleWithOpenAI(currentMessage, data.choices[0].message.content);
        } catch (titleErr) {
          console.error('Error generating title:', titleErr);
        }
        newSessionId = await saveMessage(uid, sessionId, "user", currentMessage, modelName, "chat", mode, req.user.email, generatedTitle, promptTokens, 0, attachments, null, tokenBreakdown);
      } else {
        newSessionId = await saveMessage(uid, sessionId, "user", currentMessage, modelName, "chat", mode, req.user.email, "", promptTokens, 0, attachments, null, tokenBreakdown);
      }
      const exactCost = calculateCost(modelName, promptTokens, completionTokens);
      const costBreakdown = {
        llm: exactCost,
        embedding: 0,
        vision: 0,
        energie: 0,
        rag: 0,
        hyde: 0
      };

      // Save the bot response
      await saveMessage(uid, newSessionId, "assistant", data.choices[0].message.content, modelName, "chat", mode, req.user.email, "", 0, completionTokens, [], httpResponseCode, null, costBreakdown);

      // Log activity event
      await logActivityEvent({
          uid,
          session_id: newSessionId,
          event_type: 'chat_turn',
          model: {
              id: model_id,
              name: modelName,
              provider: modelInfo.provider
          },
          usage: {
              prompt_tokens: promptTokens,
              completion_tokens: completionTokens,
              total_tokens: promptTokens + completionTokens
          },
          cost: {
              total: costBreakdown.llm + costBreakdown.embedding + costBreakdown.vision + costBreakdown.energie + costBreakdown.rag + costBreakdown.hyde,
              llm: costBreakdown.llm,
              embedding: costBreakdown.embedding,
              vision: costBreakdown.vision,
              energie: costBreakdown.energie,
              rag: costBreakdown.rag,
              hyde: costBreakdown.hyde
          },
          timings: { total_ms: 0 },
          result: { status: 'ok', http_status: httpResponseCode },
          attachments: { count: attachments.length, total_bytes: 0 }
      });

      return res.status(200).json({ ...data, sessionId: newSessionId, costBreakdown }); // Return the session ID
    }
  } catch (err) {
    console.error(`❌ Error with ${modelInfo?.name || model_id}:`, err);
    await refundDemoCredits(uid, req.user.email, typeof creditsDeducted !== 'undefined' ? creditsDeducted : 0);
    return res.status(500).json({ error: 'Failed to call AI provider' });
  }
});

app.post('/api/chat-formatanpassung', verifyFirebaseToken, async (req, res) => {
  const {
    currentMessage,
    messages: messageHistory = [],
    sessionId,
    mode,
    model_id = 'gpt-4o'
  } = req.body;
  const { uid } = req.user;

  // Check Limits for Demo Version
  const creditsDeducted = calculateCredits("formatanpassung", model_id);
  const limitCheck = await checkDemoLimits(uid, req.user.email, creditsDeducted);
  if (!limitCheck.allowed) {
    return res.status(403).json({
      error: limitCheck.reason,
      limitReached: true
    });
  }

  if (!currentMessage) {
    return res.status(400).json({ error: 'Missing user message' });
  }
  
  let modelConfig;
  const modelConfigB64 = process.env.MODEL_CONFIG_B64;
  const modelConfigStr = process.env.MODEL_CONFIG;
  
  try {
    if (modelConfigB64) {
      const decoded = Buffer.from(modelConfigB64, 'base64').toString('utf-8');
      modelConfig = JSON.parse(decoded);
    } else if (modelConfigStr) {
      modelConfig = JSON.parse(modelConfigStr);
    } else {
      modelConfig = {};
    }
  } catch (err) {
    console.error('Error parsing MODEL_CONFIG:', err);
    modelConfig = {};
  }
  
  const modelInfo = modelConfig[model_id];
  
  
  if (!modelInfo) {
    console.error(`❌ Model ${model_id} not found in MODEL_CONFIG`);
    return res.status(400).json({
      error: 'Invalid model',
      choices: [{
        message: {
          content: `Das gewählte Modell "${model_id}" ist nicht konfiguriert.`
        }
      }]
    });
  }

  const formatanpassungPrompt = getFormatanpassungPrompt(IS_EXTERNAL_VERSION);


  const messages = [
    {
      role: "system",
      content: formatanpassungPrompt
    },
    ...messageHistory.slice(-20).map(msg => ({
      role: msg.isUser ? "user" : "assistant",
      content: msg.text
    })),
    { role: "user", content: currentMessage }
  ];

  try {
    const data = await callAIProvider(modelInfo, messages);

    if (!data || !data.choices || !data.choices[0]?.message?.content) {
      throw new Error("Invalid response from AI provider");
    }

    const promptTokens = data.usage?.prompt_tokens || 0;
    const completionTokens = data.usage?.completion_tokens || 0;
    const httpResponseCode = data._httpStatus || 200;

    // Use model name instead of model_id for better readability
    const modelName = modelInfo?.name || model_id;

    // Calculate token breakdown for Formatanpassung
    const systemPrompt = messages[0].content; // First message is always system prompt
    const tokenBreakdown = calculateTokenBreakdown([], currentMessage, null, systemPrompt, messageHistory);

    const exactCost = calculateCost(modelName, promptTokens, completionTokens);
    const costBreakdown = {
      llm: exactCost,
      embedding: 0,
      vision: 0,
      energie: 0,
      rag: 0,
      hyde: 0
    };

    let newSessionId = sessionId;
    if (sessionId === null) {
      const generatedTitle = await generateTitleWithOpenAI(currentMessage, data.choices[0].message.content);
      newSessionId = await saveMessage(uid, sessionId, "user", currentMessage, modelName, "chat", mode, req.user.email, generatedTitle, promptTokens, 0, [], null, tokenBreakdown);
    } else {
      newSessionId = await saveMessage(uid, sessionId, "user", currentMessage, modelName, "chat", mode, req.user.email, "", promptTokens, 0, [], null, tokenBreakdown);
    }

    await saveMessage(uid, newSessionId, "assistant", data.choices[0].message.content, modelName, "chat", mode, req.user.email, "", 0, completionTokens, [], httpResponseCode, null, costBreakdown);

    // Log activity event
    await logActivityEvent({
        uid,
        session_id: newSessionId,
        event_type: 'format_turn',
        model: {
            id: model_id,
            name: modelName,
            provider: modelInfo.provider
        },
        usage: {
            prompt_tokens: promptTokens,
            completion_tokens: completionTokens,
            total_tokens: promptTokens + completionTokens
        },
        cost: {
            total: costBreakdown.llm + costBreakdown.embedding + costBreakdown.vision + costBreakdown.energie + costBreakdown.rag + costBreakdown.hyde,
            llm: costBreakdown.llm,
            embedding: costBreakdown.embedding,
            vision: costBreakdown.vision,
            energie: costBreakdown.energie,
            rag: costBreakdown.rag,
            hyde: costBreakdown.hyde
        },
        timings: { total_ms: 0 },
        result: { status: 'ok', http_status: httpResponseCode },
        attachments: { count: 0, total_bytes: 0 }
    });

    return res.status(200).json({ ...data, sessionId: newSessionId, costBreakdown });
  } catch (err) {
    console.error(`❌ Error with Formatanpassung (${modelInfo?.name || model_id}):`, err);
    await refundDemoCredits(uid, req.user.email, typeof creditsDeducted !== 'undefined' ? creditsDeducted : 0);
    return res.status(500).json({ error: 'Failed to process Formatanpassung request' });
  }
});

app.post('/api/call-cloud-run', verifyFirebaseToken, async (req, res) => {
  const {
    sessionId,
    role,
    content,
    model,
    type,
    mode,
    mail,
    request_type,
    user_question,
    messages,
    model_id = 'gpt-4o'  // Default to gpt-4o for backward compatibility
  } = req.body;
  
  // Map mode to chat_mode for backend
  const chat_mode = mode || 'normal';
  const { uid } = req.user;

  // Check Limits for Demo Version
  const creditsDeducted = calculateCredits(typeof chat_mode !== "undefined" ? chat_mode : (mode || "normal"), model_id);
  const limitCheck = await checkDemoLimits(uid, req.user.email, creditsDeducted);
  if (!limitCheck.allowed) {
    return res.status(403).json({
      error: limitCheck.reason,
      limitReached: true
    });
  }
  
  // Support both plain JSON and base64-encoded config
  let modelConfig;
  const modelConfigB64 = process.env.MODEL_CONFIG_B64;
  const modelConfigStr = process.env.MODEL_CONFIG;
  
  try {
    if (modelConfigB64) {
      const decoded = Buffer.from(modelConfigB64, 'base64').toString('utf-8');
      modelConfig = JSON.parse(decoded);
    } else if (modelConfigStr) {
      modelConfig = JSON.parse(modelConfigStr);
    } else {
      modelConfig = {};
    }
  } catch (err) {
    console.error('Error parsing MODEL_CONFIG:', err);
    modelConfig = {};
  }
  
  const modelInfo = modelConfig[model_id];
  
  let data = "";
  let tokenBreakdown = null;
  
  try {
    // Use callBackend function to make the request
    const cloudRunResponse = await callBackend('POST', '/', {
      request_type,
      user_question,
      messages,
      model_id,  // Pass model_id to backend
      chat_mode  // Pass chat_mode to backend
    });
    
    let costBreakdown = null;
    // Backend returns { response: string, token_breakdown: object, cost_breakdown_tokens: object }
    if (typeof cloudRunResponse.data === 'object' && cloudRunResponse.data.response) {
      data = cloudRunResponse.data.response;
      tokenBreakdown = cloudRunResponse.data.token_breakdown || null;
      if (cloudRunResponse.data.cost_breakdown_tokens) {
        costBreakdown = calculateCostBreakdownFromTokens(cloudRunResponse.data.cost_breakdown_tokens);
      }
    } else {
      // Fallback for old backend response format (just string)
      data = cloudRunResponse.data;
    }
    
    // Use model name instead of model_id for better readability
    const modelName = modelInfo?.name || model_id;

    let newSessionId = sessionId;
    
    if (sessionId === null) {
      const generatedTitle = await generateTitleWithOpenAI(content, data);
      newSessionId = await saveMessage(uid, sessionId, "user", user_question, modelName, "chat", mode, req.user.email, generatedTitle, 0, 0, [], null, tokenBreakdown);
    } else {
      newSessionId = await saveMessage(uid, sessionId, "user", user_question, modelName, "chat", mode, req.user.email, "", 0, 0, [], null, tokenBreakdown);
    }

    // Save the bot response
    await saveMessage(uid, newSessionId, "assistant", data, modelName, "chat", mode, req.user.email, "", 0, 0, [], null, null, costBreakdown);

    // Log activity event
    // Note: Token counts are not readily available in the simple response format unless we parse tokenBreakdown
    // We try to use tokenBreakdown if available
    let promptTokens = 0;
    let completionTokens = 0;
    
    if (tokenBreakdown) {
        promptTokens = (
            (tokenBreakdown.system_prompt_tokens || 0) +
            (tokenBreakdown.context_tokens || 0) +
            (tokenBreakdown.conversation_history_tokens || 0) +
            (tokenBreakdown.user_request_tokens || 0) +
            (tokenBreakdown.attachment_tokens || 0)
        );
    }
    // Completion tokens are approximated if not returned (countTokens on data)
    completionTokens = countTokens(data);

    await logActivityEvent({
        uid,
        session_id: newSessionId,
        event_type: 'rag_turn',
        model: {
            id: model_id,
            name: modelName,
            provider: modelInfo.provider
        },
        usage: {
            prompt_tokens: promptTokens,
            completion_tokens: completionTokens,
            total_tokens: promptTokens + completionTokens
        },
        cost: costBreakdown ? {
            total: costBreakdown.llm + costBreakdown.embedding + costBreakdown.vision + costBreakdown.energie + costBreakdown.rag + costBreakdown.hyde,
            llm: costBreakdown.llm,
            embedding: costBreakdown.embedding,
            vision: costBreakdown.vision,
            energie: costBreakdown.energie,
            rag: costBreakdown.rag,
            hyde: costBreakdown.hyde
        } : { total: 0, llm: 0, embedding: 0, vision: 0, energie: 0, rag: 0, hyde: 0 },
        timings: { total_ms: 0 },
        result: { status: 'ok', http_status: 200 },
        attachments: { count: 0, total_bytes: 0 }
    });

    res.status(cloudRunResponse.status).json({ data: data, sessionId: newSessionId, costBreakdown }); // Return the session ID
  } catch (err) {
    console.error(`❌ RAG Error with ${modelInfo?.name || model_id}:`, err);
    await refundDemoCredits(uid, req.user.email, typeof creditsDeducted !== 'undefined' ? creditsDeducted : 0);
    res.status(500).send(err.toString());
  }
});

/**
 * 🧠 Prompt speichern
 */
app.post("/api/prompts", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;
  const { title, description, prompt } = req.body;

  try {
    await db.collection("users").doc(uid).collection("prompts").add({
      prompt_id: uuidv4(),
      title,
      description,
      prompt,
      created_at: new Date(),
    });

    res.status(201).json({ success: true });
  } catch (err) {
    console.error("Fehler beim Speichern des Prompts:", err);
    res.status(500).json({ error: "Fehler beim Speichern des Prompts" });
  }
});


async function verifyFirebaseUser(req, res, next) {
  const authHeader = req.headers.authorization;

  if (!authHeader || !authHeader.startsWith("Bearer ")) {
    return res.status(401).json({ error: "Kein gültiger Token übermittelt" });
  }

  const idToken = authHeader.split(" ")[1];

  try {
    const decodedToken = await admin.auth().verifyIdToken(idToken);
    const uid = decodedToken.uid;
    const email = decodedToken.email || "";
    const emailVerified = decodedToken.email_verified || false;
    const displayName = decodedToken.name || "";

    // Nutzer-Dokument abrufen
    const userRef = db.collection("users").doc(uid);
    const userDoc = await userRef.get();

    // Security: Check if user is disabled in Firebase (e.g. fired employees)
    try {
      const userRecord = await admin.auth().getUser(uid);
      if (userRecord.disabled) {
        console.warn(`⛔ Blocked disabled user: ${email}`);
        return res.status(403).json({ error: "Account deaktiviert." });
      }
    } catch (e) {
      console.warn("⚠️ Could not verify user status via admin SDK:", e.message);
    }

    // Check allowlist for external version
    if (IS_EXTERNAL_VERSION) {
      const isGlobalAllowed = email && ADMIN_EMAILS.includes(email.toLowerCase());
      console.log(`[AUTH] Checking access for ${email}. GlobalAllowed: ${isGlobalAllowed}`);
      
      if (!isGlobalAllowed) {
        let accessGranted = true;
        let rejectReason = "Zugriff verweigert.";

        if (userDoc.exists) {
          const userData = userDoc.data();
          console.log(`[AUTH] User exists. Company ID: ${userData.company_id}`);
          
          if (userData.company_id) {
             const companyRef = db.collection("companies").doc(userData.company_id);
             const companyDoc = await companyRef.get();
             if (companyDoc.exists) {
               const companyData = companyDoc.data();
               const now = new Date();
               console.log(`[AUTH] Company found: ${companyData.name}. Valid: ${companyData.valid_from?companyData.valid_from.toDate():'null'} - ${companyData.valid_until?companyData.valid_until.toDate():'null'}`);
               
               // Check validity
               if (companyData.valid_from && now < companyData.valid_from.toDate()) {
                 accessGranted = false;
                 rejectReason = "Der Zugang für Ihre Firma ist noch nicht aktiv.";
               } else if (companyData.valid_until) {
                 const endOfDay = new Date(companyData.valid_until.toDate());
                 endOfDay.setHours(23, 59, 59, 999);
                 if (now > endOfDay) {
                   accessGranted = false;
                   rejectReason = "Der Zugang für Ihre Firma ist abgelaufen.";
                 }
               } else {
                 // Check domain (if restricted)
                 if (companyData.allowed_domains && companyData.allowed_domains.length > 0) {
                   const userDomain = email.split('@')[1].toLowerCase();
                   const allowed = companyData.allowed_domains.map(d => d.toLowerCase().trim());
                   console.log(`[AUTH] Checking domain ${userDomain} against ${allowed}`);
                   if (!allowed.includes(userDomain)) {
                     accessGranted = false;
                     rejectReason = `Ihre E-Mail-Domain (${userDomain}) ist für diesen Firmencode nicht freigeschaltet.`;
                   }
                 }
               }
             } else {
                console.warn(`[AUTH] Company ${userData.company_id} NOT found. Allowing re-registration.`);
                accessGranted = true;
             }
          } else {
            console.log(`[AUTH] User has no company_id. Checking path: ${req.path}`);
            if (!req.path.includes('/register-demo')) {
                accessGranted = false;
                rejectReason = "Bitte registrieren Sie sich zuerst mit einem Firmencode.";
             }
          }
        } else {
            console.log(`[AUTH] User doc does not exist. Checking path: ${req.path}`);
            if (!req.path.includes('/register-demo')) {
               accessGranted = false;
               rejectReason = "Bitte registrieren Sie sich zuerst mit einem Firmencode.";
            }
        }

        if (!accessGranted) {
           console.warn(`⛔ Blocked access for ${email}: ${rejectReason}`);
           return res.status(403).json({ error: rejectReason });
        } else {
           console.log(`[AUTH] Access granted for ${email}`);
        }
      }
    } else {
      // INTERNAL VERSION STRICT CHECK
      // Must be in INTERNAL_DOMAINS or ADMIN_EMAILS
      const isInternal = INTERNAL_DOMAINS.some(d => email.toLowerCase().endsWith(d));
      const isAdmin = ADMIN_EMAILS.includes(email.toLowerCase());

      if (!isInternal && !isAdmin) {
          console.warn(`⛔ Blocked external access to internal version for ${email}`);
          return res.status(403).json({ error: "Zugriff verweigert. Dies ist ein internes System." });
      }
    }

    // Wenn Nutzer existiert → Update Timestamp
    if (userDoc.exists) {
      await userRef.update({
        updated_at: admin.firestore.FieldValue.serverTimestamp(),
      });
    }

    const userData = (await userRef.get()).data();

    // Allow register-demo even if email not verified (to link company immediately)
    if (!decodedToken.email_verified && req.path !== '/register-demo') {
      console.warn(`⛔ Blocked access for ${email}: E-Mail nicht verifiziert`);
      return res.status(403).json({ error: "E-Mail nicht verifiziert" });
    }

    req.user = decodedToken;
    req.userData = userData;
    next();
  } catch (error) {
    console.error("Tokenprüfung fehlgeschlagen:", error.message);
    return res.status(401).json({ error: "Tokenprüfung fehlgeschlagen" });
  }
}

// Middleware to verify if user is admin
async function verifyAdmin(req, res, next) {
  if (!req.user || !req.user.email) {
    return res.status(403).json({ error: "Unauthorized" });
  }
  if (!ADMIN_EMAILS.includes(req.user.email.toLowerCase())) {
    return res.status(403).json({ error: "Access denied. Admin only." });
  }
  next();
}

/**
 * Check limits for demo users
 */
function calculateCredits(chat_mode, model_id) {
  let baseCredits = 1;
  if (chat_mode === "energy-bot") baseCredits = 2;
  else if (chat_mode === "formatanpassung") baseCredits = 3;
  
  let multiplier = 1;
  if (model_id && typeof model_id === "string") {
     const lower = model_id.toLowerCase();
     if (lower.includes("claude")) multiplier = 3;
     else if (lower.includes("gpt")) multiplier = 2;
     else if (lower.includes("gemini")) multiplier = 1;
  }
  return baseCredits * multiplier;
}

async function checkDemoLimits(uid, email, creditsToDeduct = 0) {
  if (!IS_EXTERNAL_VERSION) return { allowed: true };
  
  // Admins bypass limits
  if (email && ADMIN_EMAILS.includes(email.toLowerCase())) return { allowed: true };

  try {
    const userRef = db.collection("users").doc(uid);
    const userDoc = await userRef.get();
    const userData = userDoc.data();

    if (!userData || !userData.company_id) {
      return { allowed: false, reason: "Kein Firmencode hinterlegt. Bitte registrieren Sie sich erneut." };
    }

    const companyRef = db.collection("companies").doc(userData.company_id);
    const companyDoc = await companyRef.get();
    
    if (!companyDoc.exists) {
      return { allowed: false, reason: "Ungültige Firmenkonfiguration." };
    }
    
    const companyData = companyDoc.data();
    const now = new Date();

    // Check validity dates
    if (companyData.valid_from && now < companyData.valid_from.toDate()) {
      return { allowed: false, reason: "Der Testzeitraum hat noch nicht begonnen." };
    }
    if (companyData.valid_until) {
      const endOfDay = new Date(companyData.valid_until.toDate());
      endOfDay.setHours(23, 59, 59, 999);
      if (now > endOfDay) {
        return { allowed: false, reason: "Der Testzeitraum ist abgelaufen." };
      }
    }

    // Check daily limit
    const today = new Date().toISOString().split('T')[0];
    const usageRef = userRef.collection("usage_logs").doc(today);
    
    // Use transaction for atomic increment/check
    return await db.runTransaction(async (t) => {
      const usageDoc = await t.get(usageRef);
      const currentUsage = usageDoc.exists ? usageDoc.data().count : 0;
      const limit = companyData.daily_msg_limit || 20;
      
      if (creditsToDeduct > 0 && currentUsage + creditsToDeduct > limit) {
          return { allowed: false, reason: `Nicht genügend Credits. Benötigt: ${creditsToDeduct}, Verfügbar: ${limit - currentUsage}` };
      } else if (creditsToDeduct === 0 && currentUsage >= limit) {
          return { allowed: false, reason: "Tägliches Creditlimit erreicht.", remaining: 0, limit, valid_until: companyData.valid_until?.toDate() };
      }
      
      if (creditsToDeduct > 0) {
        t.set(usageRef, { count: currentUsage + creditsToDeduct, date: today }, { merge: true });
        return { allowed: true, remaining: limit - (currentUsage + creditsToDeduct), limit, valid_until: companyData.valid_until?.toDate() };
      } else {
        return { allowed: true, remaining: limit - currentUsage, limit, valid_until: companyData.valid_until?.toDate() };
      }
    });
  } catch (err) {
    console.error("Error checking demo limits:", err);
    // Fail safe: Allow if error? Or block? Block is safer for costs.
    return { allowed: false, reason: "Fehler bei der Limit-Prüfung." };
  }
}

async function refundDemoCredits(uid, email, creditsToRefund = 0) {
  if (!IS_EXTERNAL_VERSION || creditsToRefund <= 0) return { success: true };
  if (email && ADMIN_EMAILS.includes(email.toLowerCase())) return { success: true };

  try {
    const userRef = db.collection("users").doc(uid);
    const today = new Date().toISOString().split('T')[0];
    const usageRef = userRef.collection("usage_logs").doc(today);
    
    return await db.runTransaction(async (t) => {
      const usageDoc = await t.get(usageRef);
      if (usageDoc.exists) {
        const currentUsage = usageDoc.data().count || 0;
        const newUsage = Math.max(0, currentUsage - creditsToRefund);
        t.set(usageRef, { count: newUsage }, { merge: true });
        return { success: true };
      }
      return { success: false };
    });
  } catch (err) {
    console.error("Error refunding credits:", err);
    return { success: false };
  }
}

// --- Metrics Endpoint (Admin Only) ---
app.get('/api/metrics', verifyFirebaseToken, verifyAdmin, async (req, res) => {
  try {
    const { uid } = req.user;
    const today = new Date().toISOString().split('T')[0];
    const startOfDay = new Date();
    startOfDay.setHours(0, 0, 0, 0);

    let stats = {
      users_today: 0,
      messages_today: 0,
      tokens_today: 0,
      cost_today: 0,
      users_total: 0,
      messages_total: 0,
      tokens_total: 0,
      cost_total: 0,
      scope: 'personal' // 'global', 'company', 'personal'
    };

    // Always use Global Stats for Admins
    if (true) {
      stats.scope = 'global';
      
      // 1. Get Today's Activity (Users, Messages, Tokens, Cost)
      // Strategy: Iterative Check (Robust & No Extra Index Required)
      // 1. Find users active today (via updated_at) - narrows search space
      // 2. For each, find sessions updated today
      // 3. For each session, count messages created today
      
      const potentialUsersSnap = await db.collection('users')
        .where('updated_at', '>=', startOfDay)
        .get();
      
      // Initialize breakdown stats
      stats.users_today_internal = 0;
      stats.users_today_external = 0;
      stats.tokens_today_internal = 0;
      stats.tokens_today_external = 0;
      
      // Process users in parallel
      const userPromises = potentialUsersSnap.docs.map(async (userDoc) => {
          const uid = userDoc.id;
          const userData = userDoc.data();
          const isExternal = !!userData.company_id;
          
          let userHasActivity = false;
          let userTokens = 0;
          let userMessages = 0;
          let userCost = 0;

          // Get sessions updated today
          const sessionsSnap = await userDoc.ref.collection('chat_sessions')
              .where('last_updated', '>=', startOfDay)
              .get();
          
          if (sessionsSnap.empty) return;

          const sessionPromises = sessionsSnap.docs.map(async (sessionDoc) => {
              const messagesSnap = await sessionDoc.ref.collection('messages')
                  .where('created_at', '>=', startOfDay)
                  .get();
              
              if (!messagesSnap.empty) {
                  userHasActivity = true;
                  
                  messagesSnap.forEach(msgDoc => {
                      const data = msgDoc.data();
                      if (data.role === 'user') {
                          userMessages++;
                      }
                      
                      const input = data.tokens_input || 0;
                      const output = data.tokens_output || 0;
                      const total = input + output;
                      userTokens += total;
                      
                      if (data.cost_total !== undefined) {
                           userCost += data.cost_total;
                      } else if (data.model) {
                           let modelKey = data.model;
                           if (!MODEL_PRICING[modelKey]) {
                               modelKey = modelKey.toLowerCase();
                               if (modelKey.includes('gpt-4o')) modelKey = 'gpt-4o';
                               else if (modelKey.includes('gpt-4')) modelKey = 'gpt-4';
                               else if (modelKey.includes('gpt-3.5')) modelKey = 'gpt-3.5-turbo';
                               else if (modelKey.includes('gemini')) modelKey = 'gemini-1.5-pro';
                               else if (modelKey.includes('claude')) modelKey = 'claude-3-sonnet';
                               else modelKey = 'default';
                           }
                           userCost += calculateCost(modelKey, input, output);
                      }
                  });
              }
          });
          
          await Promise.all(sessionPromises);
          
          if (userHasActivity) {
              if (isExternal) {
                  stats.users_today_external++;
                  stats.tokens_today_external += userTokens;
              } else {
                  stats.users_today_internal++;
                  stats.tokens_today_internal += userTokens;
              }
              stats.messages_today += userMessages;
              stats.tokens_today += userTokens;
              stats.cost_today += userCost;
          }
      });
      
      await Promise.all(userPromises);
      stats.users_today = stats.users_today_internal + stats.users_today_external;

      // Total Users (Registered)
      const totalUsersSnap = await db.collection('users').count().get();
      stats.users_total = totalUsersSnap.data().count;

      // 4. Get Total Tokens & Messages (All Time)
      // Using Aggregation for efficiency
      try {
        const coll = db.collection('activity_events');
        
        // Split aggregations to avoid composite index requirements
        // Count should work without specific index
        const countSnapshot = await coll.count().get();
        stats.messages_total = countSnapshot.data().count || 0;

        // Try to sum tokens and cost (might require index)
        try {
          const sumSnapshot = await coll.aggregate({
             totalTokens: AggregateField.sum('usage.total_tokens'),
             totalCost: AggregateField.sum('cost.total')
          }).get();
          stats.tokens_total = sumSnapshot.data().totalTokens || 0;
          stats.cost_total = sumSnapshot.data().totalCost || 0;
        } catch (sumErr) {
           console.warn("Token sum aggregation failed (likely missing index):", sumErr.message);
           // Fallback to 0 if index missing
        }

        // Fallback estimate total cost if exact cost is 0
        if (stats.cost_total === 0 && stats.tokens_total > 0) {
            stats.cost_total = (stats.tokens_total / 1000) * 0.005;
        }

      } catch (aggErr) {
        console.warn("Aggregation failed:", aggErr);
      }

    }

    res.json(stats);
  } catch (err) {
    console.error("Error fetching metrics:", err);
    res.status(500).json({ error: "Failed to fetch metrics" });
  }
});

// --- Admin Endpoints ---

// Create Company
app.post('/api/admin/companies', verifyFirebaseToken, verifyAdmin, async (req, res) => {
  try {
    const { name, code, max_users, daily_msg_limit, valid_from, valid_until, allowed_models, allowed_domains } = req.body;
    
    // Logging für Debug
    console.log('[ADMIN] CreateCompany:', {
      name, code, max_users, daily_msg_limit, valid_from, valid_until, allowed_models, allowed_domains,
      user: req.user?.email,
      projectId: admin.app().options.projectId,
      dbName: FIRESTORE_DB_NAME
    });

    if (!name || !code) {
      return res.status(400).json({ error: "Name and Code are required" });
    }

    // Check if code exists
    const existing = await db.collection("companies").where("code", "==", code).get();
    if (!existing.empty) {
      return res.status(400).json({ error: "Code already exists" });
    }

    const companyData = {
      name,
      code,
      max_users: parseInt(max_users) || 5,
      daily_msg_limit: parseInt(daily_msg_limit) || 20,
      valid_from: valid_from ? new Date(valid_from) : null,
      valid_until: valid_until ? new Date(valid_until) : null,
      allowed_models: allowed_models || ["gemini-pro"],
      allowed_domains: Array.isArray(allowed_domains) ? allowed_domains : (typeof allowed_domains === 'string' ? allowed_domains.split(',').map(d => d.trim().toLowerCase()).filter(Boolean) : []),
      current_users: 0,
      created_at: admin.firestore.FieldValue.serverTimestamp(),
      created_by: req.user.email
    };

    const ref = await db.collection("companies").add(companyData);
    res.status(201).json({ id: ref.id, ...companyData });
  } catch (err) {
    console.error("Error creating company:", err);
    res.status(500).json({ error: "Failed to create company" });
  }
});

// List Companies
app.get('/api/admin/companies', verifyFirebaseToken, verifyAdmin, async (req, res) => {
  try {
    // Logging für Debug
    console.log('[ADMIN] ListCompanies:', {
