app.get("/api/sessions", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;

  try {
    const snapshot = await db
      .collection("users")
      .doc(uid)
      .collection("chat_sessions")
      .orderBy("last_updated", "desc")
      .get();

    const sessions = snapshot.docs.map(doc => {
      const data = doc.data();
      let decryptedTitle = "";
      if (data.title) {
        try {
          decryptedTitle = decrypt(data.title);
        } catch (e) {
          console.warn(`Fehler beim Entschlüsseln des Titels für Session ${doc.id}:`, e.message);
          decryptedTitle = "Chat"; // Fallback oder unverschlüsselt anzeigen
        }
      }
      return {
        sessionId: doc.id,
        ...data,
        title: decryptedTitle
      };
    }).filter(session => session.status !== "Deleted");

    res.json(sessions);
  } catch (err) {
    console.error("Fehler beim Laden der Sessions:", err);
    res.status(500).json({ error: "Fehler beim Laden der Sessions" });
  }
});
app.get("/api/sessions/:sessionId/messages", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;
  const { sessionId } = req.params;

  try {
    const snapshot = await db
      .collection("users")
      .doc(uid)
      .collection("chat_sessions")
      .doc(sessionId)
      .collection("messages")
      .orderBy("created_at")
      .get();

      const messages = snapshot.docs.map(doc => {
        const data = doc.data();
        // Decrypt attachment filenames - do NOT include token counts in response
        let decryptedContent = "";
        try {
          decryptedContent = data.content ? decrypt(data.content) : "";
        } catch (e) {
          console.warn(`Fehler beim Entschlüsseln der Nachricht ${doc.id}:`, e.message);
          decryptedContent = "Inhalt konnte nicht entschlüsselt werden.";
        }

        const decryptedAttachments = (data.attachments || []).map(att => {
          try {
            return {
              filename: decrypt(att.filename),
              size: att.size
              // tokens are stored in DB but NOT returned to client
            };
          } catch (err) {
            console.error('Error decrypting attachment filename:', err);
            return { filename: 'Unknown file', size: 0 };
          }
        });
        
        // Token breakdown is stored in DB but NOT returned to client
        
        return {
          text: decryptedContent,
          isUser: data.role === "user",
          mode: data.mode || "normal",
          mail: data.metadata?.mail || "bot",
          timestamp: data.created_at ? (data.created_at.toDate ? data.created_at.toDate() : data.created_at) : null,
          attachments: decryptedAttachments,
          http_response_code: data.http_response_code || null
          // tokenBreakdown is NOT included in response
        };
      });

    res.json(messages);
  } catch (err) {
    console.error("Fehler beim Laden der Nachrichten:", err);
    res.status(500).json({ error: "Fehler beim Laden der Nachrichten" });
  }
});


app.post("/api/messages", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;
  const { sessionId, role, content, model, type, mode, mail } = req.body;

  try {
    let sessionRef;
    if (!sessionId) {
      // Create a new session
      sessionRef = await db.collection("users").doc(uid).collection("chat_sessions").add({
        session_id: uuidv4(),
        title: content.slice(0, 20),
        status: "open",
        created_at: new Date(),
        closed_at: null,
        messages: [
          {
            message_id: uuidv4(),
            role,
            model,
            type,
            content,
            created_at: new Date(),
            mode,
            mail,
          }
        ]
      });

    } else {
      const existing = await db.collection("users").doc(uid).collection("chat_sessions").doc(sessionId).get();
      if (!existing.exists) {
        return res.status(404).json({ error: "Session nicht gefunden" });
      }
      sessionRef = existing.ref;
    }

    // Save the message
    await sessionRef.collection("messages").add({
      message_id: uuidv4(),
      role,
      model,
      type,
      content,
      created_at: new Date(),
    });

    res.status(201).json({ success: true, sessionId: sessionRef.id });
  } catch (err) {
    console.error("Fehler beim Senden der Nachricht:", err);
    res.status(500).json({ error: "Fehler beim Senden der Nachricht" });
  }
});


