// Public endpoints (no auth required)
const INTERNAL_DOMAINS = ["@eviden.com", "@atos.net", "@energy4u.org", "@alten-worldgrid.com"];

app.post('/api/validate-registration', async (req, res) => {
  const { email, code } = req.body;

  if (!email) return res.status(400).json({ valid: false, error: "Email required" });

  // Check if internal
  const isInternal = INTERNAL_DOMAINS.some(d => email.toLowerCase().endsWith(d));
  const isGlobalAllowed = ADMIN_EMAILS.includes(email.toLowerCase());

  if (isInternal || isGlobalAllowed) {
    return res.json({ valid: true });
  }

  // External registration
  if (!code) {
    return res.json({ valid: false, error: "Registrierung nicht möglich!" });
  }

  try {
    const snapshot = await db.collection("companies").where("code", "==", code).limit(1).get();
    
    if (snapshot.empty) {
      return res.json({ valid: false, error: "Registrierung nicht möglich!" });
    }

    const company = snapshot.docs[0].data();
    const now = new Date();

    // Check validity
    if (company.valid_from && now < company.valid_from.toDate()) {
       return res.json({ valid: false, error: "Registrierung nicht möglich!" });
    }
    if (company.valid_until && now > company.valid_until.toDate()) {
       const endOfDay = new Date(company.valid_until.toDate());
       endOfDay.setHours(23, 59, 59, 999);
       if (now > endOfDay) {
         return res.json({ valid: false, error: "Registrierung nicht möglich!" });
       }
    }

    // Check domain
    if (company.allowed_domains && company.allowed_domains.length > 0) {
      const userDomain = email.split('@')[1].toLowerCase();
      const allowed = company.allowed_domains.map(d => d.toLowerCase().trim());
      if (!allowed.includes(userDomain)) {
        return res.json({ valid: false, error: "Registrierung nicht möglich!" });
      }
    }
    
    // Check max users
    if (company.current_users >= company.max_users) {
        return res.json({ valid: false, error: "Registrierung nicht möglich!" });
    }

    res.json({ valid: true });

  } catch (err) {
    console.error("Error validating registration:", err);
    res.status(500).json({ error: "Validation failed" });
  }
});

