// Get user profile (for doNotMigrate flag & roles)
app.get("/api/user/profile", verifyFirebaseUser, async (req, res) => {
  const { uid, email } = req.user;
  try {
    const userDoc = await db.collection("users").doc(uid).get();
    
    // Determine Admin Status server-side
    const isAdmin = email && ADMIN_EMAILS.includes(email.toLowerCase());
    
    // Determine External Status (server-side source of truth)
    const isExternal = IS_EXTERNAL_VERSION;

    if (!userDoc.exists) {
      // Return default profile for new users (before they are created in DB fully)
      return res.status(200).json({ 
        doNotMigrate: false,
        isAdmin: !!isAdmin,
        isExternal: !!isExternal 
      });
    }
    
    const data = userDoc.data();
    res.status(200).json({ 
      doNotMigrate: !!data?.doNotMigrate,
      isAdmin: !!isAdmin,
      isExternal: !!isExternal
    });
  } catch (err) {
    console.error("Fehler beim Abrufen des Nutzerprofils:", err);
    res.status(500).json({ error: "Fehler beim Abrufen des Nutzerprofils" });
  }
});

