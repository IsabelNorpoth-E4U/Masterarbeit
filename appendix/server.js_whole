app.patch("/api/sessions/:sessionId/title", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;
  const { sessionId } = req.params;
  const { newTitle } = req.body;

  if (!newTitle) {
    return res.status(400).json({ error: "Missing new title" });
  }

  try {
    const sessionRef = db.collection("users")
      .doc(uid)
      .collection("chat_sessions")
      .doc(sessionId);

    const sessionSnap = await sessionRef.get();

    if (!sessionSnap.exists) {
      return res.status(404).json({ error: "Session not found" });
    }

    // HIER: Titel verschlüsseln!
    const encryptedTitle = encrypt(newTitle);

    await sessionRef.update({
      title: encryptedTitle,
      last_updated: new Date()
    });

    res.status(200).json({ success: true });
  } catch (err) {
    console.error("Error updating session title:", err);
    res.status(500).json({ error: "Failed to update session title" });
  }
});
app.delete("/api/sessions/:sessionId", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;
  const { sessionId } = req.params;

  try {
    const sessionRef = db.collection("users")
      .doc(uid)
      .collection("chat_sessions")
      .doc(sessionId);

    const sessionSnap = await sessionRef.get();
    if (!sessionSnap.exists) {
      return res.status(404).json({ error: "Session nicht gefunden" });
    }

    const messagesRef = sessionRef.collection("messages");
    const messagesSnap = await messagesRef.get();

    const batch = db.batch();

    // 1. Soft-delete messages (remove content field, keep tokens)
    messagesSnap.docs.forEach(doc => {
      batch.update(doc.ref, {
        content: admin.firestore.FieldValue.delete(), // Remove content field completely
        attachments: admin.firestore.FieldValue.delete(), // Remove attachments field
        isDeleted: true
      });
    });

    // 2. Soft-delete session (remove title, set status to Deleted, keep tokens)
    batch.update(sessionRef, {
      status: "Deleted",
      title: admin.firestore.FieldValue.delete(), // Remove title field completely
      isDeleted: true,
      last_updated: new Date()
    });

    await batch.commit();

    res.status(200).json({ success: true });
  } catch (err) {
    console.error("Fehler beim Löschen der Session:", err);
    res.status(500).json({ error: "Fehler beim Löschen der Session" });
  }
});

