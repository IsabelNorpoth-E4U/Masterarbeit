app.get("/api/sessions/:sessionId/pdf", verifyFirebaseUser, async (req, res) => {
  const { uid } = req.user;
  const { sessionId } = req.params;

  try {
    // Session-Titel und Nachrichten holen
    const sessionSnap = await db
      .collection("users")
      .doc(uid)
      .collection("chat_sessions")
      .doc(sessionId)
      .get();

    if (!sessionSnap.exists) {
      return res.status(404).json({ error: "Session nicht gefunden" });
    }
    const sessionData = sessionSnap.data();
    let sessionTitle = "Chat";
    if (sessionData?.title) {
      try {
        sessionTitle = decrypt(sessionData.title);
      } catch (e) {
        console.error("Fehler beim Entschlüsseln des Titels:", e);
        sessionTitle = "Chat";
      }
    }
    // Nachrichten holen
    const messagesSnap = await db
      .collection("users")
      .doc(uid)
      .collection("chat_sessions")
      .doc(sessionId)
      .collection("messages")
      .orderBy("created_at")
      .get();

    const messages = messagesSnap.docs.map(doc => {
      const data = doc.data();
      return {
        text: decryptedContent,
        isUser: data.role === "user",
        mode: data.mode || "normal",
        mail: data.metadata?.mail || "",
        timestamp: data.created_at?.toDate ? data.created_at.toDate() : data.created_at
      };
    });

    // HTML generieren mit Mermaid-Rendering
    const html = `
      <!DOCTYPE html>
      <html>
      <head>
        <meta charset="utf-8">
        <title>${sessionTitle}</title>
        <style>
          body { font-family: Arial, sans-serif; background: #f9f9f9; color: #222; margin: 0; padding: 2em; }
          h1 { font-size: 1.5em; margin-bottom: 0.5em; }
          .msg { margin-bottom: 1.5em; }
          .meta { color: #888; font-size: 0.9em; margin-bottom: 0.2em; }
          .user { font-weight: bold; }
          .assistant { color: #1976d2; }
          .bubble { background: #fff; border-radius: 8px; padding: 1em; box-shadow: 0 1px 4px #0001; }
          .mermaid-diagram { text-align: center; margin: 1rem 0; }
          .mermaid-diagram svg { max-width: 100%; height: auto; }
        </style>
        <script type="module">
          import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';
          mermaid.initialize({ startOnLoad: false, theme: 'default' });
          
            window.addEventListener('DOMContentLoaded', async () => {
              const mermaidBlocks = document.querySelectorAll('code.language-mermaid');
              for (let i = 0; i < mermaidBlocks.length; i++) {
                const block = mermaidBlocks[i];
                const code = block.textContent;
                const id = 'mermaid-' + i;
                try {
                  const { svg } = await mermaid.render(id, code);
                  const wrapper = document.createElement('div');
                  wrapper.className = 'mermaid-diagram';
                  wrapper.innerHTML = svg;
                  block.parentElement.replaceWith(wrapper);
                } catch (e) {
                  console.error('Mermaid error:', e);
                }
              }
              window.mermaidDone = true;
            });
          </script>
        </head>
        <body>
        <h1>Chat: ${sessionTitle}</h1>
        <div>
          ${messages.map((msg) => {
            // Convert markdown code blocks to HTML - handle mermaid specially
            let content = msg.text;
            
            // First, replace mermaid blocks
            content = content.replace(/```mermaid\s*\n([\s\S]*?)```/g, '<pre><code class="language-mermaid">$1</code></pre>');
            
            // Then other code blocks
            content = content.replace(/```(\w+)?\s*\n([\s\S]*?)```/g, '<pre><code class="language-$1">$2</code></pre>');
            
            // Finally, replace newlines
            content = content.replace(/\n/g, "<br>");
            
            return `
            <div class="msg">
              <div class="meta">
                <span class="${msg.isUser ? "user" : "assistant"}">
                  ${msg.isUser ? "User" : (msg.mode === "energy-bot" ? "Energiemarkt" : "Standard-Bot")}
                </span>
                ${msg.isUser && msg.mail ? ` | ${msg.mail}` : ""}
                ${!msg.isUser && msg.mail && msg.mail !== "bot" ? ` | ${msg.mail}` : ""}
                ${msg.timestamp ? ` | ${new Date(msg.timestamp).toLocaleString()}` : ""}
              </div>
              <div class="bubble">${content}</div>
            </div>
          `;
          }).join("")}
        </div>
      </body>
      </html>
    `.trim();

    // Puppeteer: Render Mermaid diagrams server-side
    let page;
    try {
      const browser = await getBrowser();
      page = await browser.newPage();
      
      await page.setContent(html, { waitUntil: "networkidle0" });
      
      // Wait for Mermaid to render all diagrams
      try {
        await page.waitForFunction('window.mermaidDone === true', { timeout: 30000 });
      } catch (e) {
        console.warn('Timeout waiting for Mermaid rendering, proceeding anyway...');
      }
      
      // Get the final HTML with rendered SVGs
      const renderedHtml = await page.content();
      
      const pdfBuffer = await page.pdf({
        format: "A4",
        printBackground: true,
        margin: { top: "20mm", bottom: "20mm", left: "15mm", right: "15mm" }
      });
      
      // PDF als Download senden
      const safeTitle = sessionTitle ? sessionTitle.replace(/[^a-z0-9]/gi, "_").toLowerCase() : "chat";
      res.set({
        "Content-Type": "application/pdf",
        "Content-Disposition": `attachment; filename="${safeTitle}.pdf"`
      });
      res.end(pdfBuffer);
    } catch (err) {
      console.error("Fehler beim PDF-Export:", err);
      res.status(500).json({ error: "Fehler beim PDF-Export", details: err.message });
    } finally {
      if (page) await page.close();
    }
  } catch (err) {
    console.error("Fehler beim PDF-Export (allgemein):", err);
    res.status(500).json({ error: "Fehler beim PDF-Export", details: err.message });
  }
});

