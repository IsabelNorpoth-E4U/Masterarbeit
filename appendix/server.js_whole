function calculateCost(modelId, promptTokens, completionTokens) {
    const pricing = MODEL_PRICING[modelId] || MODEL_PRICING['default'];
    const inputCost = (promptTokens / 1000) * pricing.input;
    const outputCost = (completionTokens / 1000) * pricing.output;
    return inputCost + outputCost;
}

function calculateCostBreakdownFromTokens(costBreakdownTokens) {
    if (!costBreakdownTokens) return null;
    const result = {
        llm: 0,
        embedding: 0,
        vision: 0,
        energie: 0,
        rag: 0,
        hyde: 0
    };

    if (costBreakdownTokens.rag_llm) {
        result.rag = calculateCost(
            costBreakdownTokens.rag_llm.model,
            costBreakdownTokens.rag_llm.prompt_tokens,
            costBreakdownTokens.rag_llm.completion_tokens
        );
    }
    
    if (costBreakdownTokens.formatanpassung_llm) {
        result.llm += calculateCost(
            costBreakdownTokens.formatanpassung_llm.model,
            costBreakdownTokens.formatanpassung_llm.prompt_tokens,
            costBreakdownTokens.formatanpassung_llm.completion_tokens
        );
    }

    if (costBreakdownTokens.hyde_1) {
        result.hyde += calculateCost(
            costBreakdownTokens.hyde_1.model,
            costBreakdownTokens.hyde_1.prompt_tokens,
            costBreakdownTokens.hyde_1.completion_tokens
        );
    }
    
    if (costBreakdownTokens.hyde_2) {
        result.hyde += calculateCost(
            costBreakdownTokens.hyde_2.model,
            costBreakdownTokens.hyde_2.prompt_tokens,
            costBreakdownTokens.hyde_2.completion_tokens
        );
    }

    if (costBreakdownTokens.embeddings) {
        // Embeddings only have input cost typically (text-embedding-3-large is ~0.00013 per 1k)
        result.embedding += calculateCost(
            costBreakdownTokens.embeddings.model,
            costBreakdownTokens.embeddings.prompt_tokens,
            costBreakdownTokens.embeddings.completion_tokens
        );
    }

    return result;
}

