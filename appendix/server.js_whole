async function saveMessage(
  uid,
  sessionId,
  role,
  content,
  model,
  type,
  mode,
  mail,
  title,
  tokens_input = 0,
  tokens_output = 0,
  attachments = [],
  http_response_code = null,
  token_breakdown = null,
  cost_breakdown = null
) {
  try {
    let sessionRef;
    const safeContent =
      typeof content === "string"
        ? content
        : JSON.stringify(content, null, 2);
 
    const safeTitle =
      title == null
        ? ""
        : typeof title === "string"
          ? title
          : JSON.stringify(title);
 
    const encryptedTitle = safeTitle ? encrypt(safeTitle) : "";
    const encryptedContent = encrypt(safeContent);
 
    if (!sessionId) {
      sessionRef = await db.collection("users").doc(uid).collection("chat_sessions").add({
          session_id: uuidv4(),
          title: encryptedTitle,
          status: "open",
          created_at: new Date(),
          last_updated: new Date(),


        });
    } else {
      const existing = await db.collection("users").doc(uid).collection("chat_sessions").doc(sessionId).get();
      if (!existing.exists) {
        console.warn(`⚠️ Session ${sessionId} not found (likely DB switch). Creating new session.`);
        sessionRef = await db.collection("users").doc(uid).collection("chat_sessions").add({
            session_id: uuidv4(),
            title: encryptedTitle || encrypt("Neue Unterhaltung"),
            status: "open",
            created_at: new Date(),
            last_updated: new Date(),
          });
      } else {
        sessionRef = existing.ref;
        await sessionRef.update({ last_updated: new Date() });
      }
    }
 
    const messageData = {
      message_id: uuidv4(),
      role,
      model,
      type,
      content: encryptedContent,
      created_at: new Date(),
      mode,
      tokens_input,
      tokens_output,
      attachments: attachments || []
    };
 
    // Add HTTP response code if provided (for assistant messages)
    if (http_response_code !== null) {
      messageData.http_response_code = http_response_code;
    }
 
    // Add detailed token breakdown as separate fields for easier querying/aggregation
    if (token_breakdown) {
      messageData.token_system_prompt = token_breakdown.system_prompt_tokens || 0;
      messageData.token_context = token_breakdown.context_tokens || 0;
      messageData.token_conversation_history = token_breakdown.conversation_history_tokens || 0;
      messageData.token_user_request = token_breakdown.user_request_tokens || 0;
      messageData.token_attachments = token_breakdown.attachment_tokens || 0;
      messageData.token_total = (
        (token_breakdown.system_prompt_tokens || 0) +
        (token_breakdown.context_tokens || 0) +
        (token_breakdown.conversation_history_tokens || 0) +
        (token_breakdown.user_request_tokens || 0) +
        (token_breakdown.attachment_tokens || 0)
      );
    }
 
    if (cost_breakdown) {
      messageData.cost_llm = cost_breakdown.llm || 0;
      messageData.cost_embedding = cost_breakdown.embedding || 0;
      messageData.cost_vision = cost_breakdown.vision || 0;
      messageData.cost_energie = cost_breakdown.energie || 0;
      messageData.cost_rag = cost_breakdown.rag || 0;
      messageData.cost_hyde = cost_breakdown.hyde || 0;
      messageData.cost_total = (
        (cost_breakdown.llm || 0) +
        (cost_breakdown.embedding || 0) +
        (cost_breakdown.vision || 0) +
        (cost_breakdown.energie || 0) +
        (cost_breakdown.rag || 0) +
        (cost_breakdown.hyde || 0)
      );
    } else {
      // Set to 0 to prevent double-counting via fallback in metric calculations
      // (because the exact cost is fully aggregated on the assistant message)
      messageData.cost_total = 0;
    }
 
    await sessionRef.collection("messages").add(messageData);
 
    return sessionRef.id;
  } catch (err) {
    console.error("Fehler beim Speichern der Nachricht:", err);
    throw err;
  }
}

/**
 * Call AI provider based on MODEL_CONFIG
 * Providers: Azure (GPT), Vertex AI (Gemini + Claude), Ollama (WSL), and LM Studio (Windows)
 */
async function callAIProvider(modelInfo, messages) {
  const { provider, deployment } = modelInfo;

  switch (provider) {
    case 'azure':
      return await callAzureOpenAI(deployment, messages);
    
    case 'vertex':
      return await callVertexAI(deployment, messages);
    
    case 'mistral':
      return await callMistralAI(deployment, messages);
    
    case 'ollama':
      return await callOllama(deployment, messages);
    
    case 'lmstudio':
      return await callLMStudio(deployment, messages);
    
    default:
      throw new Error(`Unknown provider: ${provider}`);
  }
}

/**
 * Call Azure OpenAI API
 */
async function callAzureOpenAI(deploymentName, messages) {
  const url = `${endpoint}/openai/deployments/${deploymentName}/chat/completions?api-version=${version}`;

  const response = await fetch(url, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'api-key': apiKey
    },
    body: JSON.stringify({
      messages,
      temperature: 0.7,
      top_p: 0.95,
      frequency_penalty: 0,
      presence_penalty: 0,
    })
  });

  const data = await response.json();
  data._httpStatus = response.status; // Store HTTP status for tracking
  return data;
}

/**
 * Call Google Vertex AI API
 * Handles both Gemini models and Claude (Anthropic) models via Vertex AI
 */
async function callVertexAI(modelId, messages) {
  const projectId = process.env.VERTEX_PROJECT_ID;
  const location = process.env.VERTEX_LOCATION || 'us-central1';

  if (!projectId) {
    throw new Error('Vertex AI credentials not configured (VERTEX_PROJECT_ID)');
  }

  // Get access token using Application Default Credentials
  const auth = new GoogleAuth({
    scopes: ['https://www.googleapis.com/auth/cloud-platform']
  });
  const client = await auth.getClient();
  const accessToken = await client.getAccessToken();
  
  if (!accessToken.token) {
    throw new Error('Failed to obtain access token from Application Default Credentials');
  }

  // Determine if this is a Claude model, an OpenAI model, or a Gemini model
  const isClaudeModel = modelId.startsWith('claude-');
  const isOpenAIModel = modelId.startsWith('openai/');
  
  // For 'global' location, use different hostname format
  const hostname = location === 'global'
    ? 'aiplatform.googleapis.com'
    : `${location}-aiplatform.googleapis.com`;

  if (isClaudeModel) {
    // Claude (Anthropic) via Vertex AI
    const anthropicMessages = [];
    let systemPrompt = '';
    
    for (const msg of messages) {
      if (msg.role === 'system') {
        systemPrompt = msg.content;
      } else {
        anthropicMessages.push({
          role: msg.role === 'assistant' ? 'assistant' : 'user',
          content: msg.content
        });
      }
    }

    const url = `https://${hostname}/v1/projects/${projectId}/locations/${location}/publishers/anthropic/models/${modelId}:streamRawPredict`;
    console.log(`🔍 Vertex AI (Claude) Request URL: ${url}`);

    const requestBody = {
      anthropic_version: "vertex-2023-10-16",
      messages: anthropicMessages,
      max_tokens: 16384,
      temperature: 0.7,
    };

    if (systemPrompt) {
      requestBody.system = systemPrompt;
    }

    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${accessToken.token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(requestBody)
    });

    console.log(`🔍 Vertex AI (Claude) Response Status: ${response.status}`);
    
    if (!response.ok) {
      const errorText = await response.text();
      console.error(`❌ Vertex AI (Claude) Error Response: ${errorText}`);
      throw new Error(`Vertex AI API error (${response.status}): ${errorText.substring(0, 200)}`);
    }

    const data = await response.json();

    // Convert Anthropic response to OpenAI format
    if (data.content && data.content[0] && data.content[0].text) {
      return {
        choices: [{
          message: {
            role: 'assistant',
            content: data.content[0].text
          },
          finish_reason: data.stop_reason || 'stop'
        }],
        usage: {
          prompt_tokens: data.usage?.input_tokens || 0,
          completion_tokens: data.usage?.output_tokens || 0,
          total_tokens: (data.usage?.input_tokens || 0) + (data.usage?.output_tokens || 0)
        },
        _httpStatus: response.status
      };
    }

    console.error(`❌ Invalid Vertex AI (Claude) response structure:`, data);
    throw new Error(`Invalid Vertex AI response: ${JSON.stringify(data).substring(0, 200)}`);
    
  } else if (isOpenAIModel) {
    // OpenAI models via Vertex AI (GPT-OSS)
    // Endpoint: https://${ENDPOINT}/v1/projects/${PROJECT_ID}/locations/${REGION}/endpoints/openapi/chat/completions
    
    const url = `https://${hostname}/v1/projects/${projectId}/locations/${location}/endpoints/openapi/chat/completions`;
    console.log(`🔍 Vertex AI (OpenAI) Request URL: ${url}`);

    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${accessToken.token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: modelId,
        messages: messages,
        stream: false
      })
    });

    console.log(`🔍 Vertex AI (OpenAI) Response Status: ${response.status}`);
    
    if (!response.ok) {
      const errorText = await response.text();
      console.error(`❌ Vertex AI (OpenAI) Error Response: ${errorText}`);
      throw new Error(`Vertex AI API error (${response.status}): ${errorText.substring(0, 200)}`);
    }

    const data = await response.json();
    data._httpStatus = response.status; // Store HTTP status for tracking
    return data; // Already in OpenAI format

  } else {
    // Gemini models via Vertex AI
    const contents = messages.map(msg => ({
      role: msg.role === 'assistant' ? 'model' : 'user',
      parts: [{ text: msg.content }]
    }));

    const url = `https://${hostname}/v1/projects/${projectId}/locations/${location}/publishers/google/models/${modelId}:generateContent`;
    console.log(`🔍 Vertex AI (Gemini) Request URL: ${url}`);

    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${accessToken.token}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        contents,
        generationConfig: {
          temperature: 0.7,
          topP: 0.95,
          maxOutputTokens: 16384,
        }
      })
    });

    console.log(`🔍 Vertex AI (Gemini) Response Status: ${response.status}`);
    
    if (!response.ok) {
      const errorText = await response.text();
      console.error(`❌ Vertex AI (Gemini) Error Response: ${errorText}`);
      throw new Error(`Vertex AI API error (${response.status}): ${errorText.substring(0, 200)}`);
    }

    const data = await response.json();

    // Convert Vertex AI response to OpenAI format
    if (data.candidates && data.candidates[0]) {
      return {
        choices: [{
          message: {
            role: 'assistant',
            content: data.candidates[0].content.parts[0].text
          },
          finish_reason: 'stop'
        }],
        usage: {
          prompt_tokens: data.usageMetadata?.promptTokenCount || 0,
          completion_tokens: data.usageMetadata?.candidatesTokenCount || 0,
          total_tokens: data.usageMetadata?.totalTokenCount || 0
        },
        _httpStatus: response.status
      };
    }

    console.error(`❌ Invalid Vertex AI (Gemini) response structure:`, data);
    throw new Error(`Invalid Vertex AI response: ${JSON.stringify(data).substring(0, 200)}`);
  }
}

/**
 * Call Google AI Studio API (DEPRECATED - kept for backward compatibility)
 */
async function callAIStudio(modelId, messages) {
  const apiKey = process.env.AI_STUDIO_API_KEY;

  if (!apiKey) {
    throw new Error('AI Studio API key not configured (AI_STUDIO_API_KEY)');
  }

  // Convert OpenAI format to AI Studio format
  const contents = messages.map(msg => ({
    role: msg.role === 'assistant' ? 'model' : 'user',
    parts: [{ text: msg.content }]
  }));

  const url = `https://generativelanguage.googleapis.com/v1beta/models/${modelId}:generateContent?key=${apiKey}`;

  console.log(`🔍 AI Studio Request URL: ${url.replace(apiKey, '***')}`);

  const response = await fetch(url, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      contents,
      generationConfig: {
        temperature: 0.7,
        topP: 0.95,
        maxOutputTokens: 16384,
      }
    })
  });

  console.log(`🔍 AI Studio Response Status: ${response.status}`);
  
  if (!response.ok) {
    const errorText = await response.text();
    console.error(`❌ AI Studio Error Response: ${errorText}`);
    throw new Error(`AI Studio API error (${response.status}): ${errorText.substring(0, 200)}`);
  }

  const data = await response.json();

  // Convert AI Studio response to OpenAI format
  if (data.candidates && data.candidates[0]) {
    return {
      choices: [{
        message: {
          role: 'assistant',
          content: data.candidates[0].content.parts[0].text
        },
        finish_reason: 'stop'
      }],
      usage: {
        prompt_tokens: data.usageMetadata?.promptTokenCount || 0,
        completion_tokens: data.usageMetadata?.candidatesTokenCount || 0,
        total_tokens: data.usageMetadata?.totalTokenCount || 0
      }
    };
  }

  console.error(`❌ Invalid AI Studio response structure:`, data);
  throw new Error(`Invalid AI Studio response: ${JSON.stringify(data).substring(0, 200)}`);
}

/**
 * Call Ollama API (OpenAI-compatible local server in WSL)
 * Ollama runs on port 11434 by default
 * Supports both streaming and non-streaming modes
 */
async function callOllama(modelId, messages, stream = false) {
  const ollamaUrl = process.env.OLLAMA_URL || 'http://127.0.0.1:11434';
  const url = `${ollamaUrl}/v1/chat/completions`;

  console.log(`🔍 Ollama Request URL: ${url}`);
  console.log(`🔍 Ollama Model: ${modelId}`);
  console.log(`🔍 Ollama Stream: ${stream}`);

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: modelId,
        messages,
        temperature: 0.7,
        stream: stream
      })
    });

    console.log(`🔍 Ollama Response Status: ${response.status}`);
    
    if (!response.ok) {
      const errorText = await response.text();
      console.error(`❌ Ollama Error Response: ${errorText}`);
      throw new Error(`Ollama API error (${response.status}): ${errorText.substring(0, 200)}`);
    }

    // If streaming, return the response object for SSE handling
    if (stream) {
      return response;
    }

    // Non-streaming mode
    const data = await response.json();

    // Ollama uses OpenAI-compatible format
    if (data.choices && data.choices[0] && data.choices[0].message) {
      return {
        choices: [{
          message: {
            role: 'assistant',
            content: data.choices[0].message.content
          },
          finish_reason: data.choices[0].finish_reason || 'stop'
        }],
        usage: {
          prompt_tokens: data.usage?.prompt_tokens || 0,
          completion_tokens: data.usage?.completion_tokens || 0,
          total_tokens: data.usage?.total_tokens || 0
        },
        _httpStatus: response.status
      };
    }

    console.error(`❌ Invalid Ollama response structure:`, data);
    throw new Error(`Invalid Ollama response: ${JSON.stringify(data).substring(0, 200)}`);
  } catch (error) {
    // Check if it's a connection error
    if (error.code === 'ECONNREFUSED' || error.message.includes('fetch failed')) {
      console.error(`❌ Ollama connection error:`, error);
      throw new Error(`Failed to connect to Ollama at ${ollamaUrl}. Make sure Ollama is running: ollama serve`);
    }
    throw error;
  }
}

/**
 * Call LM Studio API (OpenAI-compatible local server on Windows)
 * LM Studio runs on port 1234 by default on Windows host
 */
async function callLMStudio(modelId, messages) {
  const lmstudioUrl = process.env.LMSTUDIO_URL || 'http://172.31.96.1:1234';
  const url = `${lmstudioUrl}/v1/chat/completions`;

  console.log(`🔍 LM Studio Request URL: ${url}`);
  console.log(`🔍 LM Studio Model: ${modelId}`);

  try {
    const response = await fetch(url, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        model: modelId,
        messages,
        temperature: 0.7,
        max_tokens: 2000,
        stream: false
      })
    });

    console.log(`🔍 LM Studio Response Status: ${response.status}`);
    
    if (!response.ok) {
      const errorText = await response.text();
      console.error(`❌ LM Studio Error Response: ${errorText}`);
      throw new Error(`LM Studio API error (${response.status}): ${errorText.substring(0, 200)}`);
    }

    const data = await response.json();

    // LM Studio uses OpenAI-compatible format
    if (data.choices && data.choices[0] && data.choices[0].message) {
      return {
        choices: [{
          message: {
            role: 'assistant',
            content: data.choices[0].message.content
          },
          finish_reason: data.choices[0].finish_reason || 'stop'
        }],
        usage: {
          prompt_tokens: data.usage?.prompt_tokens || 0,
          completion_tokens: data.usage?.completion_tokens || 0,
          total_tokens: data.usage?.total_tokens || 0
        },
        _httpStatus: response.status
      };
    }

    console.error(`❌ Invalid LM Studio response structure:`, data);
    throw new Error(`Invalid LM Studio response: ${JSON.stringify(data).substring(0, 200)}`);
  } catch (error) {
    // Check if it's a connection error
    if (error.code === 'ECONNREFUSED' || error.message.includes('fetch failed')) {
      console.error(`❌ LM Studio connection error:`, error);
      throw new Error(`Failed to connect to LM Studio at ${lmstudioUrl}. Make sure LM Studio is running on Windows with the model loaded.`);
    }
    throw error;
  }
}

/**
 * Call Mistral AI API
 * Uses Mistral AI's chat completions endpoint
 */
